#!/usr/bin/env bash
# Must-fail fixture (ticket #134, D37, D42): a leaking program must fail the Valgrind check.
# It plants a definite leak in a minimal CMake project, then runs the real check the gate runs
# (`mise run ci:valgrind`, the command behind section 5 step 7). Exits 0 only when that check
# fails with its name, "ci:valgrind", and valgrind's own "definitely lost" report. A compile
# failure or a check that accepts the fault is not a pass; a missing valgrind or compiler exits
# 3 ("could not run", see `mise run ci-must-fail`).
# MUST_FAIL_PLANT=accept substitutes a clean source and runs the same memcheck.
# The lock ties Valgrind to gcc16 on Linux (D42), so the runner passes gcc16.
set -euo pipefail
# shellcheck disable=SC2046
unset $(git rev-parse --local-env-vars) # a git hook's GIT_DIR must not reach the tools below
root="$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"
compiler="${1:?compiler: gcc16}"
check="ci:valgrind"
case "$compiler" in
gcc16) cxx=g++-16 ;;
*)
	echo "unknown compiler $compiler" >&2
	exit 2
	;;
esac
command -v valgrind >/dev/null || {
	echo "could not run: valgrind is not installed" >&2
	exit 3
}
command -v "$cxx" >/dev/null || {
	echo "could not run: $cxx is not installed" >&2
	exit 3
}

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
cat >"$work/CMakeLists.txt" <<'EOF'
cmake_minimum_required(VERSION 4.5)
project(cppstd_fault LANGUAGES CXX)
enable_testing()
add_executable(fault fault.cpp)
add_test(NAME fault COMMAND fault)
EOF
cat >"$work/fault.cpp" <<'CPP'
#include <cstdlib>
int main() {
  new int[16];  // the planted leak: 64 bytes, never freed
  return 0;
}
CPP
if [[ "${MUST_FAIL_PLANT:-}" == accept ]]; then
	printf 'int main() { return 0; }\n' >"$work/fault.cpp"
fi
cmake -S "$work" -B "$work/build" -G Ninja -DCMAKE_CXX_COMPILER="$cxx" || exit 2
cmake --build "$work/build" || exit 2

rc=0
out="$(cd "$root" && mise run -q ci:valgrind --build-dir "$work/build" 2>&1)" || rc=$?
echo "$out"
if [[ $rc -eq 0 ]]; then
	echo "went green: $check accepted the fixture source" >&2
	exit 1
fi
if [[ "${MUST_FAIL_PLANT:-}" == accept ]]; then
	echo "$check rejected the clean control fixture" >&2
	exit 2
fi
grep -q '^ci:valgrind: FAIL' <<<"$out" || {
	echo "$check failed, but not with its own name" >&2
	exit 2
}
grep -q 'valgrind reported a defect' <<<"$out" || {
	echo "ci:valgrind did not report a memcheck defect" >&2
	exit 2
}
# CTest prints aggregate counts and retains the raw Valgrind report separately.
grep -Eq '[1-9][0-9,]* bytes .*definitely lost' "$work/build/Testing/Temporary"/MemoryChecker.*.log || {
	echo "the failure does not name the fault (valgrind's definitely-lost report)" >&2
	exit 2
}
printf 'int main() { return 0; }\n' >"$work/fault.cpp"
cmake --build "$work/build" || exit 2
(cd "$root" && mise run -q ci:valgrind --build-dir "$work/build") || {
	echo "$check refused the clean control" >&2
	exit 2
}
echo "REFUSED as required: $check refused a leaking program with its own name"
exit 0
