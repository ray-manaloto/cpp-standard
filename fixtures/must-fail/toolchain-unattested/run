#!/usr/bin/env python3
"""Must-fail fixture: toolchain:fetch refuses an unattested release (ticket #130, spec #122).

It runs python/toolchain/fetch.py's fetch on the code path used outside Actions (the owner's
machines: release, else a rebuild, never a staged copy), with three small stand-in archives so no
real toolchain is built and the content installed afterwards tells which one won:

- `refused`: the release's archive, with the right inputs-hash.txt but no attestation;
- `rebuilt`: what the stand-in rebuild produces;
- `before`: installed before the fetch.

The release store is a local stand-in; the verifier is the real `gh attestation verify` with
publish.yml on refs/heads/main as the signer (needs gh and a GitHub token). It exits 0 only when:

1. gh refused the archive because GitHub holds no attestation for its digest (HTTP 404), not for
   another reason such as a missing token or gh;
2. with a successful rebuild, the rebuilt content is installed, never the refused one;
3. with a failed rebuild, the content installed before is unchanged.

A fixture that cannot reach GitHub (no gh, no token, no network) exits 3, which
`mise run ci-must-fail` reports as "could not run", not as a fixture that went green.

MUST_FAIL_PLANT=accept replaces the verifier with one that accepts everything, so the refused
archive is installed and the fixture goes green: tests/must_fail/ uses it to show that
`mise run ci-must-fail` then fails.
"""

from __future__ import annotations

import hashlib
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
sys.path.insert(0, str(ROOT / "python/toolchain"))

import fetch

TAG = "standin-linux-arm64-5eed5eed5eed5eed"
HASH = "5eed5eed5eed5eed"
# How gh says GitHub holds no attestation for a digest: gh 2.104 prints the API's HTTP 404; newer
# versions may say "no attestations found". Any other refusal (no token, no gh) is not a pass.
MISSING = re.compile(r"HTTP 404|no attestations? (were )?found", re.IGNORECASE)
# gh could not ask GitHub at all: no gh, no token, no network. The fixture then could not run,
# which is reported apart from a fixture that went green (exit 3, see `mise run ci-must-fail`).
NO_ENV = re.compile(
    r"HTTP 401|Bad credentials|gh auth login|authentication|no such host|"
    r"dial tcp|connection refused|network is unreachable|timed out|not found: gh",
    re.IGNORECASE,
)
COULD_NOT_RUN = 3


def archive(path: Path, content: str) -> Path:
    with tempfile.TemporaryDirectory() as d:
        (Path(d) / "bin").mkdir()
        # A per-run nonce keeps the digest new, so no earlier attestation can exist for it.
        (Path(d) / "bin/marker").write_text(f"{content}\n{os.urandom(16).hex()}\n")
        (Path(d) / fetch.HASH_FILE).write_text(HASH + "\n")
        subprocess.run(["tar", "--zstd", "-cf", str(path), "-C", d, "."], check=True)
    return path


class LocalRelease:
    """A stand-in for GitHub Releases: one published release of TAG holding `refused`."""

    def __init__(self, refused: Path) -> None:
        self.refused = refused

    def find(self, tag: str) -> fetch.Release | None:
        listing = [
            {
                "tag_name": TAG,
                "name": TAG,
                "draft": False,
                "assets": [{"name": f"{TAG}.tar.zst"}],
            }
        ]
        return fetch.pick_release(tag, listing)

    def download(self, release: fetch.Release, asset: str, dest: Path) -> Path:
        target = dest / asset
        target.write_bytes(self.refused.read_bytes())
        return target


def main() -> int:
    env = {k: v for k, v in os.environ.items() if not k.startswith("GITHUB_ACTIONS")}
    ctx = fetch.Context.from_env(env)
    order = fetch.sources(ctx)
    problems: list[str] = []
    if ctx.kind != "outside" or order != [fetch.RELEASE, fetch.REBUILD]:
        problems.append(f"not the outside-Actions path: {ctx.kind}, {order}")

    verdicts: list[tuple[bool, str]] = []

    def verifier(path: Path) -> bool:
        if os.environ.get("MUST_FAIL_PLANT") == "accept":
            verdicts.append((True, "planted: accept everything"))
            return True
        try:
            ok, out = fetch.gh_verify_report(path)
        except FileNotFoundError:
            ok, out = False, "not found: gh is not on PATH"
        verdicts.append((ok, out))
        return ok

    with tempfile.TemporaryDirectory() as d:
        tmp = Path(d)
        refused = archive(tmp / "refused.tar.zst", "refused")
        rebuilt = archive(tmp / "rebuilt.tar.zst", "rebuilt")
        digest = hashlib.sha256(refused.read_bytes()).hexdigest()
        root = tmp / "installed"

        def installed() -> str | None:
            marker = root / TAG / "bin/marker"
            return marker.read_text().splitlines()[0] if marker.exists() else None

        def seed() -> None:
            fetch.install(archive(tmp / "before.tar.zst", "before"), TAG, root)

        def rebuild_ok(_tag: str) -> Path:
            return rebuilt

        def rebuild_fails(tag: str) -> Path:
            raise subprocess.CalledProcessError(1, ["artifact:build", tag])

        for label, rebuild, want in (
            ("refusal, then a successful stand-in rebuild", rebuild_ok, "rebuilt"),
            ("refusal and no rebuild", rebuild_fails, "before"),
        ):
            seed()
            r = fetch.fetch(
                TAG,
                root,
                order,
                LocalRelease(refused),
                verifier,
                rebuild,
                tmp / "staged",
            )
            got = installed()
            print(f"{label}: installed {got!r} from {r.source}; refusals {r.refusals}")
            if got != want:
                problems.append(f"{label}: installed {got!r}, want {want!r}")
            if not any("attestation" in x for x in r.refusals):
                problems.append(
                    f"{label}: the release was not refused for its attestation"
                )

    env_problems = [out for ok, out in verdicts if not ok and NO_ENV.search(out)]
    if env_problems:
        print(
            "FIXTURE COULD NOT RUN: gh could not ask GitHub (it needs gh, a token in GH_TOKEN or "
            f"a gh login, and the network): {env_problems[0].strip()}",
            file=sys.stderr,
        )
        return COULD_NOT_RUN
    for ok, out in verdicts:
        if ok:
            problems.append("gh attestation verify accepted the unattested archive")
        elif not (MISSING.search(out) and digest in out):
            problems.append(
                f"refused for another reason, not a missing attestation: {out.strip()}"
            )
    if not verdicts:
        problems.append("the verifier never ran")

    for p in problems:
        print(f"FIXTURE WENT GREEN: {p}", file=sys.stderr)
    if problems:
        return 1
    print("REFUSED as required: an unattested release is never installed")
    return 0


if __name__ == "__main__":
    sys.exit(main())
