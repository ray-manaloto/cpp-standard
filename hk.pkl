// The commit gate (D102, docs/designs/level-1/decisions-log.md). hk runs these steps on
// pre-commit (commit-msg runs typos on the message), `mise run check` runs them on every file, and
// the required `lint` job in ci.yml runs the same task, so CI refuses what a
// local hook refuses. The package version matches hk in .mise/conf.d/lint.toml
// and the global pin. Step options follow risu729/hk-config: strict exits,
// pedantic audits, pinact before ghalint and zizmor.
amends "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Builtins.pkl"

min_hk_version = "2.13.0"

// Locks and the lock sidecars mise generates are not hand-written, and
// vendored upstream patches must stay byte-exact for git apply. A toolchain's recorded
// build inputs (toolchains/*/macos/*-inputs.json) must stay byte-exact: their sha256 is the
// build id. The image verify test's fixture is signed bytes: the manifest's sha256 is the image digest.
exclude =
  List(
    "**/*.lock",
    "**/.mise/locks/**",
    "**/*.patch",
    "toolchains/*/macos/*-inputs.json",
    "tests/image_verify/branch-signed/**",
  )

// dotfiles' files, copied byte for byte by M1 of docs/designs/level-1/machine-bootstrap-migration.md
// (D150) so that mise.mac.toml's sources stay dotfiles' own. The style steps below skip them; every
// secret and hygiene step still runs on them. The excludes come out in M2, when the copy becomes ours to edit.
//
// repotools and workflowtools (python/repo, python/workflow) are copied the same way by #154 (D160), from the dotfiles
// commit named on #153, so the pull request can show each difference from it. Their own checks (//repo:check,
// //workflow:check, below) hold them to their package rules: ruff, ruff format, ty, codegen drift and 100% tests.
local dotfilesCopy =
  List("unix/home/**", "python/guards/**", "python/repo/**", "python/workflow/**")

local shellFiles = List(new FileSelector { glob = List("**/*.sh", "**/*.bash", ".mise/tasks/**") })
// mise.pc.toml: test_pc_fence.py reads its fence rules.
local pctoolsFiles =
  List("python/pctools/**", ".mise/tasks/pc/**", ".mise/tasks/pctools/**", "mise.pc.toml")

// The shell prefix that gives pinact an authenticated GitHub quota (#169).
local pinactAuth =
  #"GITHUB_TOKEN="${GITHUB_TOKEN:-$(gh auth token 2>/dev/null)}"; [ -n "$GITHUB_TOKEN" ] || { echo "pinact: no GitHub token: set GITHUB_TOKEN or run gh auth login (#169)" >&2; exit 1; }; export GITHUB_TOKEN;"#

local gateSteps = new Mapping<String, Step> {
  // GitHub Actions: correctness, then pins, then policy and security.
  ["jactionlint"] = (Builtins.jactionlint) {
    check = "jactionlint --profile pedantic --strict-exit --format gcc {{ files }}"
  }
  // pinact asks the GitHub API about every action it pins, and anonymous calls
  // get 60 an hour, which `hk check --all` exceeds (#169). The token comes
  // from the environment or from `gh auth token`, for this step only; it is
  // never printed or written down. With neither, the step names the fix.
  ["pinact"] = (Builtins.pinact) {
    check = "\(pinactAuth) pinact run --verify-comment --check {{ files }}"
    check_diff =
      "\(pinactAuth) hk util sarif-diff -- pinact run --verify-comment --check --format sarif {{ files }}"
    fix = "\(pinactAuth) pinact run --verify-comment {{ files }}"
  }
  ["ghalint"] = (Builtins.ghalint_workflow) { depends = List("pinact") }
  ["ghalint-action"] = (Builtins.ghalint_action) { depends = List("pinact") }
  ["zizmor"] = (Builtins.zizmor) {
    depends = List("pinact")
    // --offline: zizmor would go online whenever a token is set, so the hook
    // would depend on the shell. The online audits run in zizmor-online.
    check = "zizmor --offline --no-progress --pedantic {{ files }}"
    fix = "zizmor --offline --no-progress --pedantic --fix {{ files }}"
  }
  // The audits that need the GitHub API (impostor-commit, ref-confusion,
  // known-vulnerable-actions, ...). Only in the `online` profile:
  // `mise run check --online`, which the CI lint job runs with a token.
  ["zizmor-online"] = (Builtins.zizmor) {
    depends = List("pinact")
    profiles = List("online")
    check = "zizmor --no-progress --pedantic {{ files }}"
    fix = null
  }

  // Shell, including the file tasks under .mise/tasks/.
  // No --simplify: any printer flag makes shfmt ignore .editorconfig.
  ["shfmt"] = (Builtins.shfmt) { match_any = shellFiles }
  ["shellcheck"] = (Builtins.shellcheck) {
    match_any = shellFiles
    check = "shellcheck --external-sources --format=gcc {{ files }}"
    diagnostic_format = "gcc"
  }

  // Python: the pctools package (python/pctools, the pc:doctor task). ruff and ruff format find
  // the package's pyproject.toml for each file; ty is told the project, so it reads the package's
  // .venv, which pctools-sync makes first. The tests (100% line and branch coverage) and the
  // models.py drift check run through the package's mise tasks.
  ["pctools-sync"] {
    glob = pctoolsFiles
    check = "mise run pctools:sync"
  }
  ["ruff"] = Builtins.ruff
  ["ruff-format"] = (Builtins.ruff_format) { exclude = dotfilesCopy }
  ["ty"] = (Builtins.ty) {
    exclude = dotfilesCopy
    depends = List("pctools-sync")
    check = "ty check --project python/pctools"
  }
  ["pctools-codegen"] {
    depends = List("pctools-sync")
    glob = pctoolsFiles
    check = "mise run pctools:codegen --check"
  }
  ["pctools-test"] {
    depends = List("pctools-sync")
    glob = pctoolsFiles
    check = "mise run pctools:test"
  }
  // The standard-library scripts: each one's checks under coverage, failing below its recorded floor (#185,
  // python/README.md). They take seconds, so they run on every commit that touches their inputs.
  ["pins-cov"] {
    glob =
      List(
        "python/pins/**",
        "tests/pins_validate/**",
        "tests/artifact_tag/**",
        ".mise/tasks/pins/**",
      )
    check = "mise run pins:cov"
  }
  ["suites-cov"] {
    glob = List("python/suites/**", ".mise/tasks/suites/**")
    check = "mise run suites:cov"
  }
  ["agents-cov"] {
    glob = List("python/agents/**", ".mise/tasks/agents/cov", ".mise/tasks/slot/**")
    check = "mise run agents:cov"
  }
  ["artifact-cov"] {
    glob = List("python/artifact/**", "tests/artifact/**", ".mise/tasks/artifact/cov")
    check = "mise run artifact:cov"
  }
  ["toolchain-cov"] {
    glob =
      List(
        "python/toolchain/**",
        "python/artifact/**",
        "tests/toolchain/**",
        "tests/must_fail/**",
        "fixtures/must-fail/**",
        "toolchains/**",
        ".mise/tasks/ci-must-fail",
        ".mise/tasks/toolchain/cov",
      )
    check = "mise run toolchain:cov"
  }

  // Config and docs.
  // Every Dockerfile in the repository (D102). The builtin matches Dockerfile* only, and the
  // layers and playbook images are <name>.Dockerfile.
  ["hadolint"] = (Builtins.hadolint) {
    glob = List("**/Dockerfile*", "**/*.Dockerfile")
  }
  // CMake listfiles and the presets' toolchain files (#132, D102).
  ["cmake-format"] = (Builtins.cmake_format) {
    glob = List("**/CMakeLists.txt", "**/*.cmake")
  }
  ["mise"] = (Builtins.mise) {
    glob = List("mise.toml", "mise.ci.toml", ".mise/conf.d/*.toml")
  }
  ["mise-tasks"] {
    glob = List("mise.toml", ".mise/tasks/**")
    check = "mise task validate"
  }
  ["hk-validate"] {
    glob = List("hk.pkl")
    check = "hk validate"
  }
  ["pkl"] = Builtins.pkl
  ["pkl-format"] = Builtins.pkl_format
  ["tombi"] = (Builtins.tombi) {
    exclude = dotfilesCopy
    check = "tombi lint --error-on-warnings {{ files }}"
  }
  // mise.pc.toml stays byte for byte the entries of dotfiles' config.pc.toml until Phase 3 of
  // docs/designs/level-1/machine-bootstrap-migration.md, and mise.mac.toml keeps dotfiles' table as it
  // is until M2, so neither is reformatted.
  ["tombi-format"] = (Builtins.tombi_format) {
    exclude = List("mise.pc.toml", "mise.mac.toml") + dotfilesCopy
  }
  ["rumdl"] = (Builtins.rumdl) { exclude = dotfilesCopy }
  ["typos"] = (Builtins.typos) { exclude = dotfilesCopy }
  ["ryl"] = Builtins.ryl
  ["ryl-format"] = (Builtins.ryl_format) { exclude = dotfilesCopy }
  // jq sorts keys. The pctools schema's property order is the order of pc:doctor's JSON fields,
  // and pc-kernel.json's is the order the doctor passes the keys to sysctl, so both keep theirs.
  ["jq"] = (Builtins.jq) {
    exclude =
      List("python/pctools/schema/*.json", "python/pctools/src/pctools/data/*.json") + dotfilesCopy
  }
  ["editorconfig-checker"] = Builtins.editorconfig_checker
  ["betterleaks"] = Builtins.betterleaks

  // Hygiene.
  ["newlines"] = Builtins.newlines
  ["trailing-whitespace"] = Builtins.trailing_whitespace
  ["mixed-line-ending"] = Builtins.mixed_line_ending
  ["byte-order-marker"] = Builtins.byte_order_marker
  ["fix-smart-quotes"] = (Builtins.fix_smart_quotes) { exclude = dotfilesCopy }
  ["check-merge-conflict"] = Builtins.check_merge_conflict
  ["check-case-conflict"] = Builtins.check_case_conflict
  // The copied dsymutil link points at /usr/bin/dsymutil, which exists only on macOS (CI runs on Linux).
  ["check-symlinks"] = (Builtins.check_symlinks) {
    exclude = List("unix/home/.config/mise/apple-bin/dsymutil")
  }
  ["destroyed-symlinks"] = Builtins.destroyed_symlinks
  ["forbid-submodules"] = Builtins.forbid_submodules
  ["check-executables-have-shebangs"] = Builtins.check_executables_have_shebangs
  ["check-shebang-scripts-are-executable"] = Builtins.check_shebang_scripts_are_executable
  // test_fnox_refs.py's PEM is a stand-in key ("AAAA") that the fnox-refs check must refuse.
  ["detect-private-key"] = (Builtins.detect_private_key) {
    exclude = List("python/repo/tests/test_fnox_refs.py")
  }
  ["check-added-large-files"] = Builtins.check_added_large_files
}

// The repotools and workflowtools suites (#154, D163): lint, types, codegen drift and 100%-coverage tests through each
// package's mise task. They take minutes, so they run in `hk check` (mise run check, CI, pr-merge's hk check --pr) and
// not on pre-commit, as dotfiles ran them at pre-push and in check.
local suites = new Mapping<String, Step> {
  // Also on Linux in CI's lint job since #181; CI warms uv's cache first (uv:cache-warm), as its offline tests need.
  ["repo-check"] {
    glob = List("python/repo/**")
    check = "mise run //repo:check"
  }
  ["workflow-check"] {
    glob = List("python/workflow/**")
    check = "mise run //workflow:check"
  }
}

// Top-level steps give hk its implicit fix and pre-commit hooks
// (pre-commit fixes and stages the selected files, stashing unstaged changes).
steps = gateSteps

hooks {
  ["check"] {
    steps = (gateSteps) {
      ...suites
    }
  }
  ["commit-msg"] {
    steps {
      ["typos-msg"] {
        check = "typos {{ commit_msg_file }}"
      }
    }
  }
}
