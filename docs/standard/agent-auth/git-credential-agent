#!/bin/sh
# git's credential helper for github.com in a project container (D155): the App installation token that the
# PC's agent-secrets service keeps in /run/agent-secrets/gh-token (a read-only mount), read again at each use,
# so a refreshed token works without restarting anything. Configured in /etc/gitconfig by agents.Dockerfile.
cat >/dev/null
[ "${1:-}" = get ] || exit 0
f=/run/agent-secrets/gh-token
[ -s "$f" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$(cat "$f")"
