#!/bin/sh
# slot-shim (#194): this line marks the file as the shim, so a copy of it is never taken for real docker.
# The agent shells' docker. A SessionStart hook in .claude/settings.json puts this folder first on PATH in the Bash
# shells of Claude sessions in this repository; nothing else does, so the owner's own shells keep real docker.
# A call whose first word cannot start a container runs real docker at once, with no Python. Any other call asks
# `slot.py exec` for a verdict on its real words and environment (the slot grant of the host it is aimed at, the
# load there, no --privileged on the PC), then runs real docker with the words unchanged. docker-compose is a link
# to this file. Real docker is the first one on PATH that is no shim: not this file, not in any .mise/agent-bin
# folder (another worktree's), and not a file whose second line starts with "# slot-shim". Two shims that each took
# the other for real docker would call each other forever.
name=${0##*/}
set -f
real=
IFS=:
for dir in $PATH; do
  case ${dir%/} in
    */.mise/agent-bin) continue ;;
  esac
  file=${dir:-.}/$name
  if [ -x "$file" ] && ! [ "$file" -ef "$0" ]; then
    marker=
    { read -r _ && read -r marker; } <"$file" 2>/dev/null
    case $marker in
      "# slot-shim"*) continue ;;
    esac
    real=$file
    break
  fi
done
unset IFS
set +f
if [ -z "$real" ]; then
  echo "slot shim: no $name on PATH past $0" >&2
  exit 127
fi
case ${1-} in
  run | create | build | buildx | builder | image | container | compose | up | -*) ;;
  *) exec "$real" "$@" ;;
esac
here=$(cd "${0%/*}" && pwd -P) || exit 1
uv run --no-project --quiet python -I "$here/../../python/agents/slot.py" exec --real "$real" "$name" "$@" || exit
exec "$real" "$@"
