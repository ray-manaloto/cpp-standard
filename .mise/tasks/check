#!/usr/bin/env bash
#MISE description="Run the hk checks on every file (--fix applies the fixers)"
#USAGE flag "--fix" help="Run hk fix instead of hk check"
#USAGE flag "--online" help="Also run the checks that call the GitHub API (needs GH_TOKEN)"
set -euo pipefail
mode=check
[[ "${usage_fix:-false}" == "true" ]] && mode=fix
args=()
[[ "${usage_online:-false}" == "true" ]] && args+=(--profile online)
# The +-guard keeps an empty array legal under set -u in bash 3.2 (macOS).
exec hk ${args[@]+"${args[@]}"} "$mode" --all --no-progress --no-fail-fast
