#!/usr/bin/env bash
#MISE description="The gate: configure, build, test and gcov-mode coverage for each gate preset"
# environment-standard.md section 5. The tracer bullet (#125) runs steps 1,
# 3, 4 and 5 for the gcc16-coverage preset. M1a PR 4 (#132) adds the clang23 and p2996
# presets, each with its own coverage report (ci:coverage); the probes, the capability lock and
# gate:policy are further steps in this file.
set -euo pipefail

# The gate presets. A later PR takes the list from the capability lock. ci:fast runs the gate on one
# of them through CPPSTD_GATE_PRESETS (space-separated).
read -r -a gate_presets <<<"${CPPSTD_GATE_PRESETS:-gcc16-coverage clang23-coverage p2996-coverage}"

root="${MISE_PROJECT_ROOT:-$PWD}"
cd "$root"

# A preset name is a build directory name (build_and_test removes build/<preset>).
for preset in "${gate_presets[@]}"; do
  [[ "$preset" =~ ^[a-z0-9]+-coverage$ ]] || {
    echo "FAIL: \"$preset\" is not a gate preset name"
    exit 1
  }
done

# Step 0: the dependencies are the pinned ones (vcpkg at the baseline, D113), and the p2996
# presets have a toolchain (toolchain:fetch prints its prefix; the workflow passes it).
mise run -q vcpkg:bootstrap --check
if [[ " ${gate_presets[*]} " == *" p2996-coverage "* && ! -d "${CPPSTD_P2996_PREFIX:-}/bin" ]]; then
  echo "FAIL: CPPSTD_P2996_PREFIX must name the installed p2996 toolchain (mise run toolchain:fetch)"
  exit 1
fi

# Post-merge asks for an optional report. Record an outcome only when its check runs.
run_check() { # <item> <command> [args...]
  local item="$1" rc=0 status=passed
  shift
  "$@" || {
    rc=$?
    status=failed
  }
  if [[ -n "${CPPSTD_GATE_REPORT:-}" ]]; then
    printf 'gate-linux-arm64 %s %s\n' "$item" "$status" >>"$CPPSTD_GATE_REPORT"
  fi
  return "$rc"
}

# Steps 1 and 3: configure and build in an empty build tree.
build() { # <preset>
  rm -rf "build/$1" || return "$?"
  echo "::group::configure $1"
  cmake --preset "$1" || {
    # vcpkg prints only "unable to detect the compiler"; its own logs say why.
    echo "::endgroup::"
    echo "::group::vcpkg logs for $1 (ninja: $(command -v ninja || echo none))"
    for f in "build/$1/vcpkg-manifest-install.log" "${VCPKG_ROOT:-$root/.cache/vcpkg}"/buildtrees/detect_compiler/*.log; do
      [[ -f "$f" ]] && {
        echo "== $f"
        tail -n 40 "$f"
      }
    done
    echo "::endgroup::"
    return 1
  }
  echo "::endgroup::"
  echo "::group::build $1"
  cmake --build --preset "$1" || return "$?"
  echo "::endgroup::"
}

# Step 4: run the tests.
test_preset() { # <preset>
  echo "::group::test $1"
  # --no-tests=error: a build that registers no test fails (the guard toolchain:smoke had, #271).
  ctest --preset "$1" --no-tests=error || return "$?"
  echo "::endgroup::"
}

for preset in "${gate_presets[@]}"; do
  run_check "build-$preset" build "$preset"
  run_check "tests-$preset" test_preset "$preset"
  case "$preset" in
    *-coverage) run_check "coverage-$preset" mise run -q ci:coverage "$preset" ;;
  esac
done
