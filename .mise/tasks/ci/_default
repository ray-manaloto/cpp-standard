#!/usr/bin/env bash
#MISE description="The gate: configure, build, test and gcov-mode coverage for each gate preset"
# environment-standard.md section 5. The tracer bullet (#125) runs steps 1,
# 3, 4 and 5 for the gcc16-coverage preset. M1a PR 4 (#132) adds the clang23 and p2996
# presets, each with its own coverage report (ci:coverage); the probes, the capability lock and
# gate:policy are further steps in this file.
set -euo pipefail

# The gate presets. A later PR takes the list from the capability lock. ci:fast runs the gate on one
# of them through CPPSTD_GATE_PRESETS (space-separated).
read -r -a gate_presets <<<"${CPPSTD_GATE_PRESETS:-gcc16-coverage clang23-coverage p2996-coverage}"

root="${MISE_PROJECT_ROOT:-$PWD}"
cd "$root"

# Step 0: the dependencies are the pinned ones (vcpkg at the baseline, D113), and the p2996
# presets have a toolchain (toolchain:fetch prints its prefix; the workflow passes it).
mise run -q vcpkg:bootstrap --check
if [[ " ${gate_presets[*]} " == *" p2996-coverage "* && ! -d "${CPPSTD_P2996_PREFIX:-}/bin" ]]; then
  echo "FAIL: CPPSTD_P2996_PREFIX must name the installed p2996 toolchain (mise run toolchain:fetch)"
  exit 1
fi

# Steps 1, 3 and 4: configure, build, run the tests. Each preset starts from
# an empty build tree, so no cache entry or .gcda of an earlier run counts.
build_and_test() { # <preset>
  rm -rf "build/$1"
  echo "::group::configure $1"
  cmake --preset "$1"
  echo "::endgroup::"
  echo "::group::build $1"
  cmake --build --preset "$1"
  echo "::endgroup::"
  echo "::group::test $1"
  ctest --preset "$1"
  echo "::endgroup::"
}

for preset in "${gate_presets[@]}"; do
  build_and_test "$preset"
  case "$preset" in
    *-coverage) mise run -q ci:coverage "$preset" ;;
  esac
done
