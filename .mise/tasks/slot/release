#!/usr/bin/env bash
#MISE description="Release the caller's heavy-slot grant on a host: slot:release [--holder H] [--host mac|pc], mac by default; the caller is SLOT_HOLDER or else HC_TERMINAL_ID; also clears an expired one (#179, #194)"
#
# python/agents/slot.py (standard library only) has the record format, the holder rule and the exit codes.
# It is an accident guard, not a security boundary: any local process can write the grant files.
set -euo pipefail
root="$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"
exec uv run --no-project --quiet python -I -u "$root/python/agents/slot.py" release "$@"
