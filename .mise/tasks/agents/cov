#!/usr/bin/env bash
#MISE description="Run the agents check scripts under coverage and enforce the python/agents coverage floor"
set -euo pipefail
# A git hook exports GIT_DIR, GIT_INDEX_FILE and the rest; the checks' scratch `git init`, `commit` and `worktree add`
# would then write into this repository (its config, index and branches) instead of their own folders.
# shellcheck disable=SC2046
unset $(git rev-parse --local-env-vars)
root="$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"
cd "$root"
data="$(mktemp -d)"
trap 'rm -rf "$data"' EXIT
export COVERAGE_FILE="$data/.coverage"
# Native installs only run in the explicit agents:hook-native task.
unset CODEX_HOOK_FIXTURE_BINARY
rc=python/agents/pyproject.toml
cov=(uv run --no-project --quiet --with coverage==7.17.3 python -I -m coverage)
"${cov[@]}" run --rcfile="$rc" python/agents/slot_check.py >/dev/null
"${cov[@]}" run --rcfile="$rc" python/agents/testtab_check.py >/dev/null
"${cov[@]}" run --rcfile="$rc" python/agents/herdrtab_check.py >/dev/null
"${cov[@]}" run --rcfile="$rc" python/agents/supervise_check.py >/dev/null
"${cov[@]}" run --rcfile="$rc" python/agents/agy_worker_check.py >/dev/null
"${cov[@]}" run --rcfile="$rc" python/agents/hook_health_check.py >/dev/null
"${cov[@]}" run --rcfile="$rc" python/agents/agy_context_check.py >/dev/null
"${cov[@]}" combine --rcfile="$rc" --quiet "$data"
"${cov[@]}" report --rcfile="$rc"
