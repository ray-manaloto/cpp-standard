#!/usr/bin/env bash
#MISE description="Start (or reuse) a project container with its agents on the PC or this Mac, GitHub and Claude Code logged in with no typing: repo clone mounted, App token and Claude key mounted read-only (D151, D155)"
#USAGE arg "<project>" help="Project name; the clone is <repo url> checked out under ~/dev/containers/<project> on the PC, ~/dev/containers.noindex/<project> on the Mac"
#USAGE flag "--host <host>" default="pc" help="Where the container runs: the PC (over ssh) or this Mac (its current Docker context)" {
#USAGE   choices "pc" "mac"
#USAGE }
#USAGE flag "--repo <url>" help="GitHub repository URL (default: https://github.com/ray-manaloto/<project>.git)"
#USAGE flag "--image <ref>" help="Image (default: cpp-standard-agents:dev)"
#USAGE flag "--fresh" help="Remove the container and its agent volumes first (Codex's login is lost)"
#
# The container runs as the non-root user dev, with no --privileged and -e container=docker. The project is a separate
# clone on the host, never the host's own checkout. Logins (D155): the host's agent-secrets service mints a one-hour
# GitHub App token for this repository only and keeps it fresh, beside CLAUDE_CODE_OAUTH_TOKEN, in
# ~/.local/state/agent-secrets/<container>/ on the host, mounted read-only at /run/agent-secrets. git and gh read the
# token at each use; shells read Claude Code's key at each start. Commits are the App bot's. The Antigravity CLI and
# Codex each keep the owner's own login on their volumes, made once per project on this machine (D151, D167).
# The service: on the PC a user service (mise.pc.toml); on the Mac, which has no bash 4, flock or GNU stat, the same
# script in a container `agent-secrets` from this image, started here when missing or on an older image. It writes
# through a bind mount at the same path as on the Mac, so the folder it prints is the Mac's.
# Enter the container with:
#   PC:  ssh -t pc docker exec -it <project>-agents bash -l      Mac:  docker exec -it <project>-agents bash -l
set -euo pipefail
project="${usage_project:?}"
host="${usage_host:-pc}"
# #179, #194: container work an agent starts needs the coordinator's slot grant for the host DOCKER_HOST aims at.
[[ -z "${CLAUDECODE:-}${CODEX_THREAD_ID:-}" ]] || {
  # The same target the docker calls below get, so the check reads that host's grant.
  if [[ "$host" == mac ]]; then unset DOCKER_HOST; else export DOCKER_HOST="${DOCKER_HOST:-ssh://pc}"; fi
  mise run -q slot:check
}
name="${project}-agents"
image="${usage_image:-cpp-standard-agents:dev}"
repo="${usage_repo:-https://github.com/ray-manaloto/${project}.git}"
# Only GitHub over HTTPS: the container has no SSH key, only the App token.
repo="${repo/#git@github.com:/https://github.com/}"
repo="${repo/#ssh:\/\/git@github.com\//https://github.com/}"
slug="${repo#https://github.com/}"
slug="${slug%.git}"
[[ "$slug" =~ ^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$ ]] || {
  echo "agents:up: not a GitHub repository URL: $repo" >&2
  exit 2
}
if [[ "$host" == mac ]]; then
  unset DOCKER_HOST
  on_host() { bash -c "$1"; }
  clones=dev/containers.noindex # Spotlight indexes nothing under a .noindex folder
  enter="docker exec -it $name"
  # AGENT_SECRETS_CMD runs another copy of the service script, for tests before a change reaches the image.
  register="${AGENT_SECRETS_CMD:-docker exec agent-secrets agent-secrets}"
  state="$HOME/.local/state/agent-secrets" conf="$HOME/.config/agent-secrets"
  [[ -s "$conf/doppler-token" ]] || {
    echo "agents:up: no Doppler token at $conf/doppler-token; the owner runs mise run agents:pc-doppler" >&2
    exit 2
  }
  mkdir -p "$state"
  chmod 700 "$state"
  want="$(docker image inspect --format '{{.Id}}' "$image" 2>/dev/null)" || {
    echo "agents:up: no $image on this Mac; run mise run agents:image --host mac" >&2
    exit 2
  }
  have="$(docker container inspect --format '{{.Image}}' agent-secrets 2>/dev/null || true)"
  if [[ "$have" != "$want" ]]; then
    docker rm -f agent-secrets >/dev/null 2>&1 || true
    # The image has no system jq: the service uses the global jq and doppler (agents.Dockerfile) through mise's shims.
    docker run -d --name agent-secrets --hostname agent-secrets -e container=docker --restart unless-stopped \
      -e PATH=/opt/mise/shims:/usr/local/bin:/usr/bin:/bin -e AGENT_SECRETS_STATE="$state" \
      -e AGENT_SECRETS_CONF=/home/dev/.config/agent-secrets \
      -v "$state:$state" -v "$conf:/home/dev/.config/agent-secrets:ro" \
      "$image" agent-secrets serve >/dev/null
  else
    docker start agent-secrets >/dev/null
  fi
else
  export DOCKER_HOST="${DOCKER_HOST:-ssh://pc}"
  on_host() { ssh -o BatchMode=yes pc "$1"; }
  clones=dev/containers
  enter="ssh -t pc docker exec -it $name"
  register="${AGENT_SECRETS_CMD:-.local/bin/agent-secrets}"
fi
volumes=(claude codex gemini opencode-data opencode-config opencode-state)
if [[ -n "${usage_fresh:-}" ]]; then
  docker rm -f "$name" >/dev/null 2>&1 || true
  for v in "${volumes[@]}"; do docker volume rm "${name}-${v}" >/dev/null 2>&1 || true; done
fi
# Register first: it makes the folder as the host user (so Docker never makes it as root) and writes the token now.
keys="$(on_host "$register register '$name' '$slug'")"
home="$(on_host 'echo ~')"
# A container made before D155 (or with another key folder) lacks this mount, and a mount can only be added by
# recreating it. Its named volumes, and the logins on them, are kept; the old gh volume is left, unused.
if docker container inspect "$name" >/dev/null 2>&1; then
  src="$(docker container inspect "$name" \
    --format '{{range .Mounts}}{{if eq .Destination "/run/agent-secrets"}}{{.Source}}{{end}}{{end}}')"
  if [[ "$src" != "$keys" ]]; then
    echo "agents:up: $name has no D155 key mount; recreating it with its volumes kept" >&2
    docker rm -f "$name" >/dev/null
  fi
fi
if docker container inspect "$name" >/dev/null 2>&1; then
  docker start "$name" >/dev/null
else
  dir="${clones}/${project}"
  # The clone reads the same token file through a one-off credential helper: no token in argv, a URL or git config.
  on_host "test -d ~/$dir/.git || git -c credential.helper= \
    -c credential.helper='!f() { test \"\$1\" = get && printf \"username=x-access-token\\npassword=%s\\n\" \"\$(cat $keys/gh-token)\"; }; f' \
    clone -q '$repo' ~/$dir"
  docker run -d --name "$name" --hostname "$name" -e container=docker --restart unless-stopped \
    -v "$home/$dir:/workspace" \
    -v "$keys:/run/agent-secrets:ro" \
    -v "${name}-claude:/home/dev/.claude" \
    -v "${name}-codex:/home/dev/.codex" \
    -v "${name}-gemini:/home/dev/.gemini" \
    -v "${name}-opencode-data:/home/dev/.local/share/opencode" \
    -v "${name}-opencode-config:/home/dev/.config/opencode" \
    -v "${name}-opencode-state:/home/dev/.local/state/opencode" \
    "$image" >/dev/null
fi
# The commit identity is the App's bot (<slug>[bot] and its noreply address), from the service's git-identity file.
{
  read -r bot_name
  read -r bot_email
} < <(on_host "cat $keys/git-identity")
docker exec "$name" git config --global user.name "$bot_name"
docker exec "$name" git config --global user.email "$bot_email"
docker ps --filter "name=^${name}$" --format '{{.Names}} {{.Status}} {{.Image}}'
echo "agents:up: Claude Code, OpenCode, git and gh need no login. Once per project on this machine (the logins stay on its volumes):"
echo "  codex: $enter bash -lc 'codex login --device-auth'   (the device code is approved in the owner's browser)"
echo "  agy: mise run agents:agy-login $project --host $host --step start   (then --step finish with Google's code on stdin; D167)"
