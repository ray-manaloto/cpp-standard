#!/usr/bin/env bash
#MISE description="Build the agent image (docs/standard/agents.Dockerfile) on the PC's or this Mac's Docker, bootstrapped from this checkout's HEAD commit on GitHub"
#USAGE flag "--host <host>" default="pc" help="The PC (over ssh) or this Mac (its current Docker context)" {
#USAGE   choices "pc" "mac"
#USAGE }
#USAGE flag "--tag <tag>" help="Image tag (default: cpp-standard-agents:dev)"
#
# The build runs on the PC over the tailnet (DOCKER_HOST=ssh://pc, D29, D150), or with --host mac on the
# Mac's current Docker context, for its own architecture. HEAD must be
# pushed, because the image bootstraps from GitHub, not from this working tree. Each agent
# CLI is the latest native release (owner, 2026-11-17); the versions it got are printed.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
tag="${usage_tag:-cpp-standard-agents:dev}"
ref="$(git -C "$root" rev-parse HEAD)"
git -C "$root" branch -r --contains "$ref" | grep -q . || {
  echo "agents:image: HEAD $ref is not on GitHub yet; push it first" >&2
  exit 2
}
if [[ "${usage_host:-pc}" == mac ]]; then unset DOCKER_HOST; else export DOCKER_HOST="${DOCKER_HOST:-ssh://pc}"; fi
# #179, #194: container work an agent starts needs the coordinator's slot grant for the host it runs on.
if [[ "${usage_host:-pc}" == mac ]]; then slot_host=mac; else slot_host=pc; fi
[[ -z "${CLAUDECODE:-}${CODEX_THREAD_ID:-}" ]] || mise run -q slot:check --host "$slot_host"
docker build --progress=plain --build-arg "CPP_STANDARD_REF=$ref" --build-arg "AGENTS_CACHE_BUST=$(date +%s)" -t "$tag" \
  -f "$root/docs/standard/agents.Dockerfile" "$root/docs/standard"
docker run --rm "$tag" cat /home/dev/.agent-versions
