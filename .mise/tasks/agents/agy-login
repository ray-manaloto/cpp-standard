#!/usr/bin/env bash
#MISE description="Signs the Antigravity CLI in to the owner's Google account in a project container, from a terminal (D155, D166)"
#USAGE arg "<project>" help="Project name; the container is <project>-agents"
#USAGE flag "--host <host>" default="pc" help="The PC (over ssh) or this Mac (its current Docker context)" {
#USAGE   choices "pc" "mac"
#USAGE }
#
# agy's sign-in is interactive: it prints a link, which is opened in a browser and signed in with the owner's Google
# account. agents:up does not start agy; it only names this task. The login stays on the project's gemini volume,
# once per project per machine.
set -euo pipefail
name="${usage_project:?}-agents"
# The sign-in needs a terminal.
[[ -t 0 && -t 1 ]] || {
  echo "agents:agy-login: needs a terminal: agy's Google sign-in is interactive" >&2
  exit 2
}
if [[ "${usage_host:-pc}" == mac ]]; then
  unset DOCKER_HOST
  exec docker exec -it "$name" bash -lc agy
fi
exec ssh -t pc docker exec -it "$name" bash -lc agy
