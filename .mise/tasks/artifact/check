#!/usr/bin/env bash
#MISE description="Wait until every Linux tag a pull request needs exists, up to 3 hours (D61, D62)"
#USAGE arg "[tag]..." var=#true help="Tags to wait for (default: this commit's tools image for --arch)"
#USAGE flag "--arch <arch>" help="Docker arch of the default tag" default="arm64" {
#USAGE   choices "arm64" "amd64"
#USAGE }
#USAGE flag "--timeout <seconds>" help="How long to wait" default="10800"
#USAGE flag "--interval <seconds>" help="Seconds between registry probes" default="60"
#
# The required `artifact-check` check (environment-standard.md section 2 step 6). A tag exists
# when main's image is in GHCR, or in a pull-request or merge-queue run, that run's own pr- image
# (D54, D134); the PR number comes from GITHUB_REF. It fails after the wait naming each missing
# tag and the builder run ($BUILDER_RUN). The tags of the base image are covered by the tools
# image, which is built on it. Toolchain tags arrive with M1a PR 3.
set -euo pipefail
root="${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"
# Artifact tags hold no spaces or quotes, so splitting on whitespace is exact.
read -ra tags <<<"${usage_tag:-}"
if [[ ${#tags[@]} -eq 0 ]]; then
  tags=("$(python3 -I "$root/python/pins/pins.py" tag tools --arch "${usage_arch:-arm64}" --root "$root")")
fi
exec python3 -I "$root/python/artifact/artifact.py" check "${tags[@]}" \
  --timeout "${usage_timeout:-10800}" --interval "${usage_interval:-60}"
