#!/usr/bin/env bash
#MISE description="Install pctools' locked dependencies into python/pctools/.venv"
#MISE dir="{{config_root}}/python/pctools"
set -euo pipefail
# mise's pinned Python (build.toml on the Mac, mise.ci.toml in CI), never one uv finds or downloads.
UV_PYTHON="$(mise which python)" UV_PYTHON_DOWNLOADS=never exec uv sync --locked --quiet
