#!/usr/bin/env bash
#MISE description="pctools' real tests (no mocking library) at 100% line and branch coverage; extra args go to pytest"
#MISE dir="{{config_root}}/python/pctools"
#MISE depends=["pctools:sync"]
#USAGE arg "[args]..." help="Arguments for pytest" var=#true
set -euo pipefail
# Serial: the suite takes seconds, so no xdist worker pool.
# record.py (#186) passes the output and status through and keeps the wall time, slowest tests and load.
exec python3 -I ../suites/record.py run pctools -- .venv/bin/python -I -m pytest --durations=25 "$@"
