#!/usr/bin/env bash
#MISE description="Move every apt pin to the newest version in its index (D165); --check fails when a pinned version is gone"
#USAGE flag "--check" help="Change nothing: fail, naming each package, when a pinned version is no longer in its index"
#USAGE flag "--group <group>" default="all" help="Which pins move: the apt.llvm.org ones, the Ubuntu archive ones (with the snapshot date), or both" {
#USAGE   choices "all" "llvm" "ubuntu"
#USAGE }
# Reads the Ubuntu 26.10 archive and apt.llvm.org for arm64 and amd64, checks each index against its release
# file's checksum, and rewrites only the version strings of the pins in .mise/conf.d/apt.toml,
# .mise/conf.d/apt-toolchain-host.toml and mise.ubuntu.toml, printing one line per changed package. With nothing
# to change it changes no file and exits 0. The skill of the same name (.agents/skills/pins-apt-bump) runs this
# task, and so does the daily apt-bump workflow. Index downloads only: not a heavy run.
set -euo pipefail

python3 -c 'import sys; sys.exit(sys.version_info < (3, 11))' || {
  echo "FAIL: python3 is $(python3 --version 2>&1); 3.11 or later is needed" >&2
  exit 1
}

root="${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"
if [[ "${usage_check:-false}" == "true" ]]; then
  if [[ "${usage_group:-all}" != "all" ]]; then
    echo "FAIL: --check covers every pin; it takes no --group" >&2
    exit 1
  fi
  exec python3 -I "$root/python/pins/apt_bump.py" check --root "$root"
fi
exec python3 -I "$root/python/pins/apt_bump.py" bump --root "$root" --group "${usage_group:-all}"
