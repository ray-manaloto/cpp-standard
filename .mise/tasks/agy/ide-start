#!/usr/bin/env bash
#MISE description="Opens the Antigravity desktop app in the background"
#USAGE flag "--app <app>" default="antigravity" help="antigravity is Antigravity.app (com.google.antigravity); ide is Antigravity IDE.app (com.google.antigravity-ide)" {
#USAGE   choices "antigravity" "ide"
#USAGE }
# Run from anywhere with: mise -C <cpp-standard checkout> run agy:ide-start
set -euo pipefail
root="${MISE_PROJECT_ROOT:-$PWD}"
exec uv run --no-project --quiet python -I -u "$root/python/agents/agy_ide.py" start --app "${usage_app:-antigravity}"${usage_timeout:+ --timeout "$usage_timeout"}
