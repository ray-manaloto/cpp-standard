#!/usr/bin/env bash
#MISE description="Run every must-fail fixture; fail if any check accepts its planted fault (D37, D42)"
# environment-standard.md section 5 and the ci-must-fail row of the file plan; the required `must-fail` check runs it
# in the tools image, and it runs the same way outside Actions. fixtures/must-fail/expected.toml lists each fixture and
# the check that must refuse it; `<fixture>/run` exits 0 only when that check refused the fault for the right reason,
# and 3 when it could not run at all (the toolchain fixture needs gh, a GitHub token and the network).
# A fixture that goes green (the check accepted the fault), a listed fixture with no `run`, a fixture directory that
# expected.toml does not list, or an empty list fails the run. $CPPSTD_MUST_FAIL_DIR replaces fixtures/must-fail for
# the runner's own test (tests/must_fail/). Ticket #130 adds the first fixture; M1a PR 4 adds the gate's.
set -euo pipefail
root="${MISE_PROJECT_ROOT:-$(git -C "$(dirname "$0")" rev-parse --show-toplevel)}"
dir="${CPPSTD_MUST_FAIL_DIR:-$root/fixtures/must-fail}"
listed="$(python3 -I -c '
import sys, tomllib
try:
    with open(sys.argv[1], "rb") as f:
        fixtures = tomllib.load(f).get("fixture", {})
except (OSError, tomllib.TOMLDecodeError) as e:
    sys.exit(f"FAIL: cannot read {sys.argv[1]}: {e}")
for name, row in sorted(fixtures.items()):
    if not isinstance(row, dict) or not row.get("check"):
        sys.exit(f"FAIL: fixture {name} in {sys.argv[1]} names no check")
    print(name, row["check"])
' "$dir/expected.toml")"
[[ -n "$listed" ]] || {
  echo "FAIL: $dir/expected.toml lists no fixture" >&2
  exit 1
}
failed=0
for d in "$dir"/*/; do
  name="$(basename "$d")"
  awk -v n="$name" '$1 == n { found = 1 } END { exit !found }' <<<"$listed" || {
    echo "FAIL: $name is not listed in expected.toml" >&2
    failed=1
  }
done
while read -r -u 3 name check; do
  echo "::group::must-fail $name ($check)"
  if [[ ! -x "$dir/$name/run" ]]; then
    echo "FAIL: $name has no executable run" >&2
    failed=1
  else
    rc=0
    "$dir/$name/run" </dev/null || rc=$?
    if [[ $rc -eq 0 ]]; then
      echo "PASS: $check refused $name"
    elif [[ $rc -eq 3 ]]; then
      # Exit 3: the fixture could not run (no gh, token or network); the check was not tested.
      echo "FAIL: $name could not run: see its output (gh, GH_TOKEN and network are needed)" >&2
      failed=1
    else
      echo "FAIL: $name went green: $check did not refuse it as it must" >&2
      failed=1
    fi
  fi
  echo "::endgroup::"
done 3<<<"$listed"
[[ $failed -eq 0 ]] || exit 1
echo "PASS: every must-fail fixture was refused"
