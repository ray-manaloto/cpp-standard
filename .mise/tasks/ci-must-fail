#!/usr/bin/env bash
#MISE description="Run every must-fail fixture; fail if any check accepts its planted fault (D37, D42)"
# environment-standard.md section 5 and the ci-must-fail row of the file plan; the required `must-fail` check runs it
# in the tools image, and it runs the same way outside Actions. fixtures/must-fail/expected.toml lists each fixture and
# the check that must refuse it; `<fixture>/run` exits 0 only when that check refused the fault for the right reason,
# and 3 when it could not run at all (the toolchain fixture needs gh, a GitHub token and the network).
# A fixture with a `capability` row applies where the committed capability lock allows that capability (D42, never a
# live probe): the runner runs it once per such compiler, passing the compiler as the run's argument, and skips it,
# with the lock's reasons, where the lock disallows it. A fixture that goes green (the check accepted the fault), a
# listed fixture with no `run`, a fixture directory that expected.toml does not list, or an empty list fails the run.
# $CPPSTD_MUST_FAIL_DIR replaces fixtures/must-fail for the runner's own test (tests/must_fail/); $CPPSTD_CAPS_LOCK
# and $CPPSTD_CAPS_ENVIRONMENT replace the lock and the environment the same way (tests/caps/ and tests/must_fail/).
# Ticket #130 adds the first fixture; M1a PR 4 adds the gate's; #134 ties the sanitizer, TSan and Valgrind fixtures
# to the capability lock.
set -euo pipefail
# A git hook exports GIT_DIR, GIT_WORK_TREE, GIT_INDEX_FILE and the rest; clear them so a test or fixture's
# scratch `git init` or `git commit` cannot reach the real repository (#280).
# shellcheck disable=SC2046
unset $(git rev-parse --local-env-vars)
root="${MISE_PROJECT_ROOT:-$(git -C "$(dirname "$0")" rev-parse --show-toplevel)}"
dir="${CPPSTD_MUST_FAIL_DIR:-$root/fixtures/must-fail}"
lock="${CPPSTD_CAPS_LOCK:-$root/cmake/capabilities.lock.json}"
listed="$(python3 -I -c '
import sys, tomllib
try:
    with open(sys.argv[1], "rb") as f:
        fixtures = tomllib.load(f).get("fixture", {})
except (OSError, tomllib.TOMLDecodeError) as e:
    sys.exit(f"FAIL: cannot read {sys.argv[1]}: {e}")
for name, row in sorted(fixtures.items()):
    if not isinstance(row, dict) or not row.get("check"):
        sys.exit(f"FAIL: fixture {name} in {sys.argv[1]} names no check")
    presets = row.get("presets", [])
    if not isinstance(presets, list) or not all(
        isinstance(preset, str) and preset.replace("-", "").isalnum() for preset in presets
    ) or len(set(presets)) != len(presets):
        sys.exit(f"FAIL: fixture {name} in {sys.argv[1]} lists invalid presets")
    print(name, row["check"], row.get("capability", ""), ",".join(presets))
' "$dir/expected.toml")"
[[ -n "$listed" ]] || {
  echo "FAIL: $dir/expected.toml lists no fixture" >&2
  exit 1
}
# A fixture builds its own repositories; under a git hook the outer repository's variables would make it
# commit to, or set core.worktree in, this one. Drop them, and fail a fixture that still moves HEAD or sets core.worktree.
# shellcheck disable=SC2046
unset $(git rev-parse --local-env-vars)
repo_state() { echo "$(git -C "$root" rev-parse HEAD 2>/dev/null) $(git -C "$root" config --get core.worktree 2>/dev/null || true)"; }
failed=0
for d in "$dir"/*/; do
  name="$(basename "$d")"
  awk -v n="$name" '$1 == n { found = 1 } END { exit !found }' <<<"$listed" || {
    echo "FAIL: $name is not listed in expected.toml" >&2
    failed=1
  }
done
while read -r -u 3 name check capability presets; do
  echo "::group::must-fail $name ($check)"
  if [[ ! -x "$dir/$name/run" ]]; then
    echo "FAIL: $name has no executable run" >&2
    failed=1
    echo "::endgroup::"
    continue
  fi
  compilers=("")
  if [[ -n "$capability" ]]; then
    # The lock decides where a capability fixture applies (D42): the fixture runs once per
    # compiler the lock allows the capability for, never where a live probe would.
    allowed="$(python3 -I "$root/python/caps/caps.py" applicable "$capability" --lock "$lock" --presets "${presets:-}")" || {
      echo "FAIL: the lock lookup for $name ($capability) failed" >&2
      failed=1
      echo "::endgroup::"
      continue
    }
    read -r -a compilers <<<"$allowed"
    if [[ ${#compilers[@]} -eq 0 ]]; then
      echo "skipped: $name applies to no compiler here: the lock allows no $capability"
      if [[ "$capability" != tsan ]]; then
        echo "FAIL: $name requires $capability" >&2
        failed=1
      elif [[ -n "${CPPSTD_GATE_REPORT:-}" ]]; then
        printf 'must-fail must-fail-%s skipped\n' "$name" >>"$CPPSTD_GATE_REPORT"
      fi
      echo "::endgroup::"
      continue
    fi
  fi
  ran=0
  unavailable=0
  fixture_failed=0
  repo_changed=0
  for compiler in "${compilers[@]}"; do
    rc=0
    state="$(repo_state)"
    if [[ -n "$compiler" ]]; then
      "$dir/$name/run" "$compiler" </dev/null || rc=$?
    else
      "$dir/$name/run" </dev/null || rc=$?
    fi
    if [[ "$(repo_state)" != "$state" ]]; then
      echo "FAIL: $name changed the repository (HEAD or core.worktree)" >&2
      repo_changed=1
    fi
    if [[ $rc -eq 0 ]]; then
      ran=1
    elif [[ $rc -eq 3 ]]; then
      # Exit 3: the fixture could not run (no gh, token, compiler or network); the check was not tested.
      echo "FAIL: $name could not run (on ${compiler:-the host}): see its output (gh, GH_TOKEN, the compilers and network are needed)" >&2
      unavailable=1
    elif [[ $rc -eq 1 ]]; then
      ran=1
      fixture_failed=1
      if [[ -n "$compiler" ]]; then
        echo "FAIL: $name went green (on $compiler): $check did not refuse it as it must" >&2
      else
        echo "FAIL: $name went green: $check did not refuse it as it must" >&2
      fi
    elif [[ $rc -eq 2 ]]; then
      echo "FAIL: $name did not demonstrate the expected refusal on ${compiler:-the host}" >&2
      fixture_failed=1
    else
      echo "FAIL: $name returned an unexpected result (on ${compiler:-the host}): see its output" >&2
      unavailable=1
    fi
  done
  status=
  if [[ $fixture_failed -eq 1 || $repo_changed -eq 1 ]]; then
    status=failed
  elif [[ $ran -eq 1 && $unavailable -eq 0 ]]; then
    status=passed
  fi
  if [[ $status == passed ]]; then
    echo "PASS: $check refused $name"
  fi
  if [[ -n "$status" && -n "${CPPSTD_GATE_REPORT:-}" ]]; then
    printf 'must-fail must-fail-%s %s\n' "$name" "$status" >>"$CPPSTD_GATE_REPORT"
  fi
  [[ $status == passed ]] || failed=1
  echo "::endgroup::"
done 3<<<"$listed"
[[ $failed -eq 0 ]] || exit 1
echo "PASS: every applicable must-fail fixture was refused"
