# --- L. Library features ------------------------------------------------------

compilers="" missing_cxx=""
command -v $L >/dev/null && compilers="$compilers clang23-libcxx clang23-libstdcxx" || missing_cxx="$missing_cxx clang23"
[[ -x "$P" ]] && compilers="$compilers p2996" || missing_cxx="$missing_cxx p2996"
command -v $G >/dev/null && compilers="$compilers gcc16" || missing_cxx="$missing_cxx gcc16"
cxx_of() { case "$1" in clang23-libcxx) echo "$L -stdlib=libc++" ;; clang23-libstdcxx) echo "$L" ;; p2996) echo "$P" ;; gcc16) echo "$G" ;; esac }

if want L1; then
  bad=""
  for c in $compilers; do
    for h in expected flat_map format mdspan print ranges; do
      # shellcheck disable=SC2046
      printf '#include <%s>\n' "$h" | $(cxx_of "$c") -std=c++26 -fsyntax-only -x c++ - >/dev/null 2>&1 || bad="$bad $c:<$h>"
    done
  done
  for c in $missing_cxx; do bad="$bad $c:not-installed"; done
  [[ -z "$bad" ]] && res L1 PASS "all six headers on:$compilers" || res L1 FAIL "failed:$bad"
fi
if want L2; then
  printf '#include <version>\n__cpp_lib_generator __cpp_lib_stacktrace\n' >v.cpp
  bad=""
  for c in $compilers; do
    o="$($(cxx_of "$c") -std=c++26 -E -P v.cpp 2>/dev/null | tail -1 | tr -s ' ')"
    case $c in gcc16 | clang23-libstdcxx) e="202207L 202011L" ;; *) e="__cpp_lib_generator __cpp_lib_stacktrace" ;; esac
    [[ "$o" == "$e" ]] || bad="$bad $c='$o'"
  done
  for c in $missing_cxx; do bad="$bad $c:not-installed"; done
  [[ -z "$bad" ]] && res L2 PASS "matches the table on:$compilers" || res L2 FAIL "differs or not checked:$bad"
fi
if want L3; then
  printf '#include <version>\n#if defined(__cpp_impl_reflection) || __has_feature(reflection)\nREFL_YES\n#else\nREFL_NO\n#endif\n' >l3.cpp
  gp="$($G -std=c++26 -freflection -E -P l3.cpp 2>/dev/null | tail -1)"
  pp="$("$P" -std=c++26 -freflection-latest -E -P l3.cpp 2>/dev/null | tail -1)"
  [[ "$gp" == REFL_YES && "$pp" == REFL_YES ]] && res L3 PASS "the two-part guard matches on GCC 16 and p2996" || res L3 FAIL "gcc16 ${gp:-none}; p2996 ${pp:-none}"
fi
if want L4; then
  printf '#include <stacktrace>\n#include <print>\nint main(){ std::println("frames={}", std::stacktrace::current().size() > 0); }\n' >st.cpp
  a="$($G -std=c++26 -g st.cpp -o st0 >/dev/null 2>&1 && echo links || echo no-link)"
  b="$($G -std=c++26 -g st.cpp -o st1 -lstdc++exp 2>&1 && ./st1)"
  [[ "$a" == no-link && "$b" == "frames=true" ]] && res L4 PASS "<stacktrace> needs -lstdc++exp: without it the link fails; with it frames=true" ||
    res L4 FAIL "without -lstdc++exp: $a; with: ${b:0:80}"
fi

# --- H. Hardening ---------------------------------------------------------------

want H1 && res H1 N/A "per-project rule: apt libc++ defaults to NONE (H2), so every libc++ preset sets _LIBCPP_HARDENING_MODE"
if want H2; then
  printf '#include <vector>\nint main(){std::vector<int> v(1); return v[5];}\n' >h.cpp
  run() {
    ./"$1" >/dev/null 2>&1
    echo $?
  }
  def="$(grep -h 'define _LIBCPP_HARDENING_MODE_DEFAULT' /usr/lib/llvm-23/include/c++/v1/__config_site | awk '{print $3}')"
  cbad=""
  $L -std=c++26 -stdlib=libc++ h.cpp -o h_none >/dev/null 2>&1 || cbad="$cbad h0"
  $L -std=c++26 -stdlib=libc++ -D_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_EXTENSIVE h.cpp -o h_ext >/dev/null 2>&1 || cbad="$cbad h1"
  $G -std=c++26 -D_GLIBCXX_ASSERTIONS h.cpp -o h_gcc >/dev/null 2>&1 || cbad="$cbad h2"
  a="$(run h_none)" b="$(run h_ext)" c="$(run h_gcc)" d="no p2996"
  if [[ -x "$P" ]]; then
    "$P" -std=c++26 h.cpp -o h_p >/dev/null 2>&1 || cbad="$cbad h3"
    d="$(run h_p)"
  fi
  # h0 must run and end normally: 0-125 (126/127: did not run; 128+: a signal).
  if [[ -z "$cbad" && "$def" == 2 && "$a" -le 125 && "$b" == 132 && "$c" == 134 && "$d" == 132 ]]; then
    res H2 PASS "apt libc++ default NONE (2): no trap; EXTENSIVE: exit 132 (SIGILL); _GLIBCXX_ASSERTIONS: 134 (SIGABRT); p2996 default: 132"
  else res H2 FAIL "${cbad:+compile failed:$cbad; }apt default $def exit $a (want 0-125); extensive $b (want 132); glibcxx $c (want 134); p2996 $d (want 132)"; fi
fi

