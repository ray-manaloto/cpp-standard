  fs="$(stat -fc %T "$BUILD_DIR" 2>/dev/null)"
  mkdir -p v4/src && for i in $(seq 1 192); do printf '#include <map>\n#include <string>\n#include <vector>\nint f%d(){ std::map<std::string,std::vector<int>> m; m["a"].push_back(%d); return int(m.size()); }\n' "$i" "$i" >"v4/src/f$i.cpp"; done
  # shellcheck disable=SC2016 # ${s} is CMake syntax, written literally
  printf 'cmake_minimum_required(VERSION 4.5)\nproject(v4 LANGUAGES CXX)\nfile(GLOB s src/*.cpp)\nadd_library(v4 STATIC ${s})\n' >v4/CMakeLists.txt
  t() { # t BUILD-DIR: configure, then time a full -j build (best of 3, cleaned each time)
    rm -rf "$1" && cmake -S v4 -B "$1" -G Ninja -DCMAKE_CXX_COMPILER=$G >/dev/null 2>&1 &&
      hyperfine -N -r 3 -p "ninja -C $1 -t clean" --export-json hf4.json -- "ninja -C $1 -j$(nproc)" >/dev/null 2>&1 &&
      python3 -I "$PROBE/hf_best.py" hf4.json | tr -d " "
  }
  o="$(t "$PROBE/v4b")" v="$(t "$BUILD_DIR/v4b")"
  rm -rf "$BUILD_DIR/v4b"
  if [[ "$fs" != overlay* && -n "$o" && -n "$v" ]]; then
    res V4 PASS "[timing] \$BUILD_DIR on $fs, not overlayfs; 192-file build: overlayfs ${o}ms, $fs ${v}ms"
  else res V4 FAIL "[timing] \$BUILD_DIR '$BUILD_DIR' on ${fs:-missing}; overlayfs ${o:-?}ms, volume ${v:-?}ms"; fi
fi
if want V5; then
  c=/sys/devices/system/cpu
  res V5 N/A "host settings, reported only: governor $(cat $c/cpu0/cpufreq/scaling_governor 2>/dev/null), driver $(cat $c/cpu0/cpufreq/scaling_driver 2>/dev/null), EPP $(cat $c/cpu0/cpufreq/energy_performance_preference 2>/dev/null), boost $(cat $c/cpufreq/boost 2>/dev/null), SMT $(cat $c/smt/control 2>/dev/null), THP $(sed 's/.*\[\(.*\)\].*/\1/' /sys/kernel/mm/transparent_hugepage/enabled 2>/dev/null) $HK"
fi
exit 0
