if want T3; then
  iw="$(command -v include-what-you-use 2>/dev/null)"
  v="" r=127
  [[ -n "$iw" ]] && {
    v="$("$iw" --version 2>&1)"
    r=$?
  }
  cv="$(clang++-23 --version | head -1 | grep -oE 'clang version [0-9.]+')"
  if [[ $r == 0 && "$v" == *"include-what-you-use 0.27"* && -n "$cv" && "$v" == *"$cv"* ]]; then
    iwyu_works "$iw" && res T3 PASS "$(head -1 <<<"$v" | cut -c1-150); flags the unused <vector>" ||
