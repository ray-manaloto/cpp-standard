# --- R. Profiling -------------------------------------------------------------------

$G -std=c++26 -O2 p.cpp -o rp >/dev/null 2>&1
if want R1; then
  v="$(perf --version 2>&1)"
  [[ "$v" == "perf version"* ]] && res R1 PASS "$v (linux-perf $(dpkg-query -W -f '${Version}' linux-perf)) $HK" || res R1 FAIL "${v:-perf not found} $HK"
fi
if want R2; then
  o="$(perf stat -x, -e cycles,instructions,cache-misses,branch-misses -- ./rp 2>&1 >/dev/null)"
  n="$(grep -cE '^[0-9]+,' <<<"$o")"
  [[ "$n" == 4 ]] && res R2 PASS "cycles, instructions, cache-misses, branch-misses counted (--privileged); outside the Level-1 gate (D46) $HK" ||
    res R2 FAIL "$n of 4 counters: $(head -1 <<<"$o") $HK"
fi
if want R3; then
  perf record -q -F 999 -g -o r3.data -- ./rp >/dev/null 2>&1
  s="$(perf report -i r3.data --stdio 2>/dev/null | grep -c '%')"
  [[ "$s" -ge 1 ]] && res R3 PASS "perf record + report: $s sample lines $HK" || res R3 FAIL "perf record wrote no samples $HK"
fi
if want R4; then
  printf 'int dot(const int*a,const int*b,int n){int s=0;for(int i=0;i<n;++i)s+=a[i]*b[i];return s;}\n' >k.cpp
  o="$($L -O2 -march=znver3 -S k.cpp -o k.s 2>&1 && llvm-mca-23 -mcpu=znver3 k.s 2>/dev/null | grep -m1 Iterations)"
  q="$([[ -x "$P" ]] && "$P" -O2 -march=znver3 -S k.cpp -o kp.s 2>&1 && "$P2996/bin/llvm-mca" -mcpu=znver3 kp.s 2>/dev/null | grep -m1 Iterations)"
  [[ "$o" == *100* && "$q" == *100* ]] && res R4 PASS "llvm-mca -mcpu=znver3: Iterations 100 (clang 23 and p2996)" || res R4 FAIL "clang23: ${o:-fail}; p2996: ${q:-fail}"
fi
if want R5; then
  $L -std=c++26 -ftime-trace -c p.cpp -o p.o >/dev/null 2>&1
