# --- U. CPU target --------------------------------------------------------------------

targets="x86-64 x86-64-v3 x86-64-v3+tune znver3"
tflags() { case "$1" in x86-64) echo "-march=x86-64" ;; x86-64-v3) echo "-march=x86-64-v3" ;; x86-64-v3+tune) echo "-march=x86-64-v3 -mtune=znver3" ;; znver3) echo "-march=znver3" ;; esac }
if want U1; then
  bad=""
  for t in $targets; do
    # shellcheck disable=SC2046
    $G -O2 $(tflags "$t") -c -x c++ /dev/null -o /dev/null 2>/dev/null || bad="$bad gcc:$t"
    # shellcheck disable=SC2046
    $L -O2 $(tflags "$t") -c -x c++ /dev/null -o /dev/null 2>/dev/null || bad="$bad clang:$t"
  done
  nat="$($G -march=native -Q --help=target 2>/dev/null | awk '$1=="-march=" {print $2; exit}')"
  [[ -z "$bad" && "$nat" == znver3 ]] && res U1 PASS "both compilers accept x86-64, x86-64-v3, -mtune=znver3, znver3; gcc -march=native = $nat" ||
    res U1 FAIL "rejected:${bad:- none}; -march=native = ${nat:-?}"
fi
if want U2; then
  g="$(diff <($G -march=x86-64-v3 -Q --help=target | awk '$2=="[enabled]" && $1 ~ /^-m/ {print $1}' | sort) \
    <($G -march=znver3 -Q --help=target | awk '$2=="[enabled]" && $1 ~ /^-m/ {print $1}' | sort) | sed -n 's/^> -m//p' | tr '\n' ' ')"
  res U2 N/A "znver3 adds over x86-64-v3 (gcc): ${g% }; a -march=znver3 binary needs these on every machine that runs it"
fi
if want U3; then
  out="" ref="" bad=""
  for t in $targets; do
    # shellcheck disable=SC2046
    $G -std=c++26 -O2 $(tflags "$t") bench.cpp -o "b_$t" >/dev/null 2>&1 || {
      bad="$bad $t:build"
      continue
    }
    r="$("./b_$t")"
    [[ -z "$ref" ]] && ref="$r"
    [[ "$r" == "$ref" ]] || bad="$bad $t:output"
    out="$out $t=$(best_ms "./b_$t")ms/$(instr_u "./b_$t")i"
  done
  [[ -z "$bad" ]] && res U3 N/A "[timing] gcc -O2 bench, best of 5 on cores 2-5:$out" || res U3 FAIL "[timing]$bad;$out"
fi
if want U4; then
  # Link time: the same objects, each linker, best of 5.
  mkdir -p u4 && for i in $(seq 1 64); do printf '#include <string>\n#include <vector>\nstd::string f%d(std::vector<int> v){ return std::to_string(v.size() + %d); }\n' "$i" "$i" >"u4/f$i.cpp"; done
  printf '#include <print>\nint main(){ std::println("ok"); }\n' >u4/main.cpp
  bad=""
  for f in u4/*.cpp; do $G -std=c++26 -O2 -g -c "$f" -o "${f%.cpp}.o" || bad="$bad compile:${f#u4/}"; done
  out=""
  # clang drives all three links: it finds ld.lld beside itself, where g++-16 looks for an
  # unversioned ld.lld that LLVM 23's packages do not install.
  for ld in bfd lld mold; do
    rm -f "u4/a_$ld"
    ms="$(best_ms $L -fuse-ld=$ld u4/*.o -o u4/a_$ld)"
    out="$out $ld=${ms:-?}ms"
    [[ -n "$ms" && "$(./u4/a_$ld 2>&1)" == ok ]] || bad="$bad $ld"
  done
  [[ -z "$bad" ]] && res U4 N/A "[timing] link 65 objects with -g, best of 5:$out" || res U4 FAIL "[timing] failed:$bad;$out"
fi
if want U5; then
  ref="$($G -std=c++26 -O2 bench.cpp -o u5r && ./u5r)" ok=""
  [[ "$($G -std=c++26 -O2 -flto=auto bench.cpp -o u5a 2>&1 && ./u5a)" == "$ref" ]] && ok="$ok gcc-lto"
  [[ "$($L -std=c++26 -O2 -flto=thin -fuse-ld=lld bench.cpp -o u5b 2>&1 && ./u5b)" == "$ref" ]] && ok="$ok clang-thinlto"
  # GCC names the profile after the output file, so both builds use -o u5g.
  $G -std=c++26 -O2 -fprofile-generate bench.cpp -o u5g >/dev/null 2>&1 && ./u5g >/dev/null &&
    [[ "$($G -std=c++26 -O2 -fprofile-use -Werror=missing-profile bench.cpp -o u5g 2>&1 && ./u5g)" == "$ref" ]] && ok="$ok gcc-pgo"
  $L -std=c++26 -O2 -fprofile-generate bench.cpp -o u5c >/dev/null 2>&1 && LLVM_PROFILE_FILE=u5.profraw ./u5c >/dev/null &&
    llvm-profdata-23 merge -o u5.profdata u5.profraw &&
    [[ "$($L -std=c++26 -O2 -fprofile-use=u5.profdata bench.cpp -o u5d 2>&1 && ./u5d)" == "$ref" ]] && ok="$ok clang-pgo"
  [[ "$ok" == " gcc-lto clang-thinlto gcc-pgo clang-pgo" ]] && res U5 PASS "LTO and PGO build and give the same output:$ok" || res U5 FAIL "passed:${ok:- none}"
fi

# --- V. Container runtime ---------------------------------------------------------------

if want V1; then
