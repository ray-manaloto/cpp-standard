fi
if want R6; then
  v="$(hyperfine --version 2>&1 | head -1)"
  [[ "$v" == hyperfine* ]] && res R6 PASS "$v" || res R6 FAIL "${v:-hyperfine not found}"
fi
if want R7; then
  c() { valgrind --tool=callgrind --callgrind-out-file=/dev/null ./rp 2>&1 | awk '/Collected/ {print $4}'; }
  a="$(c)" b="$(c)"
  [[ -n "$a" && "$a" == "$b" ]] && res R7 PASS "callgrind instruction count $a, identical on two runs (D46 Level-1 metric)" || res R7 FAIL "runs: '$a' '$b'"
