if want T4; then
  ok=""
  for f in realtime type; do $L -std=c++26 -fsanitize=$f p.cpp -o t_$f >/dev/null 2>&1 && [[ "$(./t_$f)" == ok ]] && ok="$ok $f"; done
  $L -fsanitize=fuzzer "$PROBE/fuzz.cpp" -o t_fz >/dev/null 2>&1 && ./t_fz -runs=16 >t_fz.log 2>&1 && grep -q 'Done 16 runs' t_fz.log && ok="$ok fuzzer"
  [[ "$ok" == " realtime type fuzzer" ]] && res T4 PASS "rtsan, tysan run; libFuzzer fuzz.cpp: Done 16 runs, exit 0" || res T4 FAIL "passed:${ok:- none}"
fi
if want T5; then
  v="$(valgrind --version)"
  printf '#include <cstdio>\nint main(){int* p=new int[2]; int r=p[2]; delete[] p; std::printf("%%d\\n", r>0);}\n' >inv.cpp
  $G -g -O0 leak.cpp -o vl >/dev/null 2>&1 && $G -g -O0 inv.cpp -o vi >/dev/null 2>&1 && $G -std=c++26 -O2 p.cpp -o vp >/dev/null 2>&1
  a="$(valgrind --leak-check=full ./vl 2>&1 | grep -c 'definitely lost: 16 bytes')"
  b="$(valgrind ./vi 2>&1 | grep -c 'Invalid read of size 4')"
  c="$(valgrind --tool=callgrind --callgrind-out-file=cg.out ./vp 2>&1 | grep -c 'Collected')"
  d="$(valgrind --tool=cachegrind --cache-sim=yes --cachegrind-out-file=cc.out ./vp 2>&1 | grep -c 'D1  miss rate')"
  [[ "$a" -ge 1 && "$b" -ge 1 && "$c" -ge 1 && "$d" -ge 1 ]] && res T5 PASS "$v: memcheck leak and invalid read; callgrind; cachegrind" ||
    res T5 FAIL "$v: leak $a, invalid read $b, callgrind $c, cachegrind $d"
fi
if want T6; then
  have=""
  for t in cppcheck ClangBuildAnalyzer clang-uml mrdocs; do command -v $t >/dev/null && have="$have $t"; done
  res T6 N/A "tier-2 tools (D19); installed:${have:- none}"
fi
if want T7; then
  rm -f xray-log.*
  $L -std=c++26 -fxray-instrument -fxray-instruction-threshold=1 p.cpp -o px >/dev/null 2>&1 &&
    XRAY_OPTIONS="patch_premain=true xray_mode=xray-basic" ./px >/dev/null 2>&1
  ls xray-log.* >/dev/null 2>&1 && res T7 PASS "xray-log written (clang 23)" || res T7 FAIL "no xray-log"
