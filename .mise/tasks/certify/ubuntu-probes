  ce="$(awk '/^CapEff/ {print $2}' /proc/self/status)" sc="$(awk '/^Seccomp:/ {print $2}' /proc/self/status)"
  perfmon=$(((16#$ce >> 38) & 1)) sysadmin=$(((16#$ce >> 21) & 1))
  [[ $perfmon == 1 && $sysadmin == 1 && "$sc" == 0 ]] &&
    res V2 PASS "CapEff $ce: all capabilities incl. PERFMON and SYS_ADMIN; no seccomp filter: --privileged (D137) $HK" ||
    res V2 FAIL "CapEff $ce (perfmon $perfmon, sys_admin $sysadmin); seccomp $sc $HK"
