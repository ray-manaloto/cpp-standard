#!/usr/bin/env bash
#MISE description="Run the Ubuntu 26.10 certification checks in docs/standard/ubuntu.md (amd64 on the PC's Docker, or arm64 here with --local) and print the report"
#USAGE flag "--local" help="Certify the arm64 image in this Mac's Docker Desktop instead of the PC over ssh"
#USAGE flag "--out <file>" help="Also write the report to this file"
#USAGE flag "--only <ids>" help="Run only these checks: comma-separated ids or section prefixes (A3,DB,C)"
#USAGE flag "--name <label>" help="Machine label in the report header (default: pc)"
#USAGE flag "--allow-fail" help="Exit 0 even when a check fails (for writing a baseline)"
#USAGE flag "--keep" help="Keep the container and the scratch directory with the probe files"
#USAGE flag "--ab" help="Also run V6, the host-vs-container A/B (writes a rootfs under /var/tmp on the Docker host, deleted after)"
#USAGE flag "--image <ref>" help="The image to certify (default: cpp-standard-cert-ubuntu:26.10, built by certify:ubuntu-image)"
#
# The launcher half of the Ubuntu certification (docs/standard/ubuntu.md).
# It runs on the Mac and reaches the Docker host over ssh: set
# CERT_UBUNTU_SSH to the ssh destination of the PC (an ssh alias on the
# tailnet). It starts one container with the playbook's docker run flags
# (RUN_FLAGS below), copies in the probe sources from the playbook's
# appendix and the in-container script (certify/ubuntu-probes), runs it,
# and assembles the report. Timing checks run in a second pass bracketed by
# samples of every other container's CPU usage on the host; if any of them
# used CPU, those lines become N/A "timing untrusted". It installs nothing,
# changes nothing on the host, and removes the container on exit (playbook
# rule 4). Bash 3.2 compatible: macOS /bin/bash.
# shellcheck disable=SC2015
set -uo pipefail

root="$(git rev-parse --show-toplevel)"
doc="$root/docs/standard/ubuntu.md"
inner="$root/.mise/tasks/certify/ubuntu-probes"
[[ -f "$doc" && -f "$inner" ]] || {
  echo "certify: $doc or $inner not found" >&2
  exit 2
}
# Rule 4 needs mise's auto-install off for the whole run: by the time this
# task starts, a plain `mise run` has already installed any missing tool of
# this repository's config on the Mac, and a shim this launcher calls can still install one.
# The task cannot undo that, so it refuses to run and names the safe form
# (docs/designs/level-1/research/mise-auto-install.md).
if [[ "${MISE_AUTO_INSTALL:-}" != 0 ]]; then
  echo "certify: run it as MISE_AUTO_INSTALL=0 mise run certify:ubuntu ...; with auto-install on, mise can install a missing tool before or during the run (playbook rule 4)" >&2
  exit 2
fi
# Rule 4 proof for this Mac-side launcher: watch the install folders of the
# tools this repository pins, now and after the run. The report gives the
# result, and any change fails the run, --allow-fail or not.
inst_dir="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}/installs"
# Only the tools this repository pins are watched: mise's current tools whose
# config file is in this repository, by their install folders. Other sessions
# on a shared Mac install unrelated tools (a Claude Code update into mise's
# node, another project's linters), and rule 4 is that no check passes on a
# tool the run installed. installs/.mise, mise's own lock files, is outside
# every watched folder.
inst_watch="$(mise -C "$root" ls --current --json |
  jq -r --arg r "$root/" '[.[][] | select((.source.path // "") | startswith($r)) | .install_path] | unique[]')" &&
  [[ -n "$inst_watch" ]] || {
  echo "certify: cannot list this repository's pinned tools (rule 4 proof)" >&2
  exit 2
}
inst_list() { # the watched folders that exist now
  local d
  while IFS= read -r d; do [[ ! -e "$d" ]] || printf '%s\n' "$d"; done <<<"$inst_watch"
}
# Names alone miss a reinstall into an existing folder, so inside the watched
# folders, at any depth, a marker file taken now flags any file modified
# during the run, and a walk of every path, taken now and at the end, names
# any path added or removed (a folder missing at the start and present at
# the end shows as added). Both skip __pycache__, the compiled bytecode any
# Python run writes next to its sources, which is not an install. The
# cleanup handler set later removes the marker and the walks too.
inst_mark="$(mktemp "${TMPDIR:-/tmp}/certify-mark.XXXXXX")" || exit 2
trap 'rm -f "$inst_mark" "$inst_mark.start" "$inst_mark.end"' EXIT
inst_walk() { # inst_walk [FIND-TESTS]: every path in the watched folders, sorted
  (
    while IFS= read -r d; do
      [[ -e "$d" ]] || continue
      find -H "$d" -name __pycache__ -prune -o "$@" -print || exit 1
    done <<<"$inst_watch"
  ) | LC_ALL=C sort
}
inst_walk >"$inst_mark.start" || {
  echo "certify: cannot walk the pinned tools' install folders (rule 4 proof)" >&2
  exit 2
}
inst_before="$(inst_list)"
local_docker="${usage_local:-false}"
if [[ "$local_docker" == true ]]; then
  # arm64 in this Mac's Docker Desktop. The "Docker host" is Docker Desktop's
  # Linux VM: hostsh runs there, in the VM's own namespaces (nsenter into PID 1).
  dest=""
  # This Mac's Docker Desktop, whatever DOCKER_HOST or the current context say.
  unset DOCKER_HOST
  export DOCKER_CONTEXT=desktop-linux
  [[ "$(docker info -f '{{.OperatingSystem}} {{.Architecture}}' 2>/dev/null)" == "Docker Desktop aarch64" ]] || {
    echo "certify: --local needs this Mac's Docker Desktop (context desktop-linux) running on Apple silicon" >&2
    exit 2
  }
else
  dest="${CERT_UBUNTU_SSH:-}"
  [[ -n "$dest" ]] || {
    echo "certify: set CERT_UBUNTU_SSH to the ssh destination of the Docker host (the PC), or pass --local" >&2
    exit 2
  }
  export DOCKER_HOST="ssh://$dest"
fi
# #179, #194: container work an agent starts needs the coordinator's slot grant for the host DOCKER_HOST aims at.
[[ -z "${CLAUDECODE:-}${CODEX_THREAD_ID:-}" ]] || mise run -q slot:check
only="${usage_only:-}"
out="${usage_out:-}"
[[ -z "$out" || "$out" == /* ]] || out="$PWD/$out"
label="${usage_name:-pc}"
[[ "$local_docker" == true && -z "${usage_name:-}" ]] && label=mac-arm64
image="${usage_image:-cpp-standard-cert-ubuntu:26.10}"

# The docker run flags the playbook certifies (section V). Never --privileged
# (the agents rule "No --privileged containers on the PC"): each need gets its
# one flag. perf: --cap-add PERFMON (Docker's default seccomp profile allows
# perf_event_open with CAP_PERFMON; the host's perf_event_paranoid still
# applies). lldb's default launch and the sanitizers turn off ASLR with
# personality(ADDR_NO_RANDOMIZE | current), which the default profile refuses
# for every capability, so the container uses docs/standard/ubuntu-seccomp.json:
# Docker 29.9.2's default profile plus that one value. ptrace needs no flag
# (allowed on kernels >= 4.8). The docker CLI reads the profile file locally,
# so it works with DOCKER_HOST=ssh://. container=docker makes procps' postinst
# skip `sysctl --system` if anything ever runs apt in it. No cgroup limits (V1),
# build trees on a volume (V4).
build_vol=cpp-standard-cert-build # labelled org.cpp-standard.cert=1
seccomp_profile="$root/docs/standard/ubuntu-seccomp.json"
RUN_FLAGS="--cap-add PERFMON --security-opt seccomp=$seccomp_profile -e container=docker --hostname cert -v $build_vol:/build"
TIMING_IDS="U3 U4 V4"

pin="$(grep -oE 'pinned commit \(today `[0-9a-f]{40}' "$doc" | grep -oE '[0-9a-f]{40}' | head -1)"
digest="$(grep -oE 'ubuntu:26\.10@sha256:[0-9a-f]{64}' "$doc" | head -1 | sed 's/^ubuntu:26\.10@//')"
# The p2996 install volume is named after its whole build input: the commit and
# the hash of the build script and patches, so a new input never overwrites it.
p2996_in="$(cat "$root"/docs/standard/ubuntu-p2996/build-linux.sh "$root"/docs/standard/ubuntu-p2996/*.patch | shasum -a 256 | cut -c1-12)"
# CERT_P2996_VOL mounts another volume instead (a scratch build under test); the
# report header names the volume, so such a report is never mistaken for the pinned one.
p2996_vol="${CERT_P2996_VOL:-cpp-standard-p2996-${pin:0:12}-$p2996_in}"
scratch="$(mktemp -d "${TMPDIR:-/tmp}/certify-ubuntu.XXXXXX")"
cname="cpp-standard-cert-$$"
cleanup() {
  rm -f "$inst_mark" "$inst_mark.start" "$inst_mark.end"
  if [[ "${usage_keep:-false}" == true ]]; then
    echo "certify: kept container $cname and $scratch" >&2
  else
    docker rm -f "$cname" >/dev/null 2>&1
    rm -rf "$scratch"
  fi
}
trap cleanup EXIT

want() { # want ID: is this check selected by --only?
  [[ -z "$only" ]] && return 0
  local IFS=, tok
  for tok in $only; do
    [[ "$1" == "$tok" || "$1" == "$tok"[0-9]* ]] && return 0
  done
  return 1
}
hostsh() {
  if [[ "$local_docker" == true ]]; then
    docker run --rm --privileged --pid=host --net=host --label org.cpp-standard.cert=1 "$image" \
      nsenter -t 1 -m -u -i -n -p sh -c "$*"
  else ssh -o BatchMode=yes "$dest" "$@"; fi
}
mask() { # mask the Mac's home and user, and the ssh destination
  local tilde='~' s
  s="$(cat)"
  s="${s//"$HOME"/$tilde}"
  s="${s//"$(id -un)"/<user>}"
  # The destination only as a whole host name: a short alias such as `pc`
  # must not hit `vpclmulqdq` or `cppcheck`. An alias equal to the machine
  # label names nothing private, so it stays.
  [[ -z "$dest" || "$dest" == "$label" ]] ||
    s="$(D="$dest" perl -pe 's/(?<![\w.-])\Q$ENV{D}\E(?![\w.-])/<pc>/g' <<<"$s")"
  printf '%s\n' "$s"
}

# --- probe sources from the playbook appendix ---------------------------------

mkdir -p "$scratch/probes/cmake"
awk -v dir="$scratch/probes" '
  /^## Appendix: probe sources/ { app = 1 }
  !app { next }
  /^```/ {
    if (inb) { inb = 0; if (out != "") close(out); out = "" } else { inb = 1; first = 1 }
    next
  }
  inb && first {
    first = 0
    if (match($0, /^(\/\/|#) (refl\.cpp|san\.cpp|fuzz\.cpp|dap\.cpp|dap_probe\.py|bench\.cpp|heavy\.cpp|CMakeLists\.txt)/)) {
      name = substr($0, RSTART, RLENGTH); sub(/^(\/\/|#) /, "", name)
      out = dir "/" name
    }
  }
  inb && out != "" { print > out }
' "$doc"
mv "$scratch/probes/CMakeLists.txt" "$scratch/probes/cmake/" 2>/dev/null
sed -n 's/^# CMakeLists.txt, next to m.cpp: //p' "$doc" | head -1 |
  perl -pe 's/^import std; */import std;\n/' >"$scratch/probes/cmake/m.cpp"
for f in refl.cpp san.cpp fuzz.cpp dap.cpp dap_probe.py bench.cpp heavy.cpp cmake/m.cpp cmake/CMakeLists.txt; do
  [[ -s "$scratch/probes/$f" ]] || {
    echo "certify: could not extract $f from the playbook appendix" >&2
    exit 2
  }
done
cp "$inner" "$scratch/probes/ubuntu-probes"
# hf_best.py FILE: the fastest wall time of each command in a hyperfine 2.x
# --export-json file, in ms (results[].measurements[].time_wall_clock, seconds).
cat >"$scratch/probes/hf_best.py" <<'PY'
import json, sys
for r in json.load(open(sys.argv[1]))["results"]:
    w = [m["time_wall_clock"] for m in r["measurements"] if m.get("exit_code") == 0]
    assert w and all(x["unit"] == "second" for x in w), "no successful run, or unit not seconds"
    print(round(min(x["value"] for x in w) * 1000), end=" ")
print()
PY

# --- the container ---------------------------------------------------------------

docker image inspect "$image" >/dev/null 2>&1 || {
  echo "certify: image $image not found on the Docker host; run mise run certify:ubuntu-image" >&2
  exit 2
}
image_id="$(docker image inspect -f '{{.Id}}' "$image")"
image_base="$(docker image inspect -f '{{index .Config.Labels "org.opencontainers.image.base.digest"}}' "$image")"
p2996_mount=""
docker volume inspect "$p2996_vol" >/dev/null 2>&1 && p2996_mount="-v $p2996_vol:/opt/p2996:ro"
host_threads="$(hostsh nproc)"
host_binfmt="$(hostsh 'test -e /proc/sys/fs/binfmt_misc/qemu-x86_64 && echo yes || echo no')"
host_arch="$(hostsh 'uname -m')"
if [[ "$local_docker" == true ]]; then
  host_kernel_desc="Docker Desktop's Linux VM kernel on this Mac"
else host_kernel_desc="the PC's Omarchy kernel"; fi
docker_ver="$(docker version -f '{{.Server.Version}}' 2>/dev/null)"
# The seccomp profile is a copy of one Docker release's default, and a custom
# profile replaces the default entirely, so a newer Docker's fixes do not reach
# it. Refresh it on every Docker upgrade (docs/standard/ubuntu.md V2).
profile_docker=29.9.2
[[ "$docker_ver" == "$profile_docker" ]] || echo "certify: WARNING: Docker $docker_ver, but ubuntu-seccomp.json is Docker $profile_docker's default plus one rule; refresh it (ubuntu.md V2)" >&2
docker volume inspect "$build_vol" >/dev/null 2>&1 || docker volume create --label org.cpp-standard.cert=1 "$build_vol" >/dev/null
# GPU offload (GO): the compute device nodes (the ones the host's CDI spec lists,
# without the display-only nvidia-modeset and /dev/dri) and the host's NVIDIA
# user-space driver, read-only. The libraries must match the host's kernel
# module exactly, so they come from the host, never from the image. Both
# offload plugins dlopen the unversioned libcuda.so
# (offload/plugins-nextgen/cuda/dynamic_cuda/cuda.cpp), and GCC's PTX is
# compiled by the driver's libnvidia-ptxjitcompiler. Upgrade path: CDI through
# nvidia-container-toolkit on the host (via dotfiles-lead).
gpu_mount="" gpu_driver=""
gpu_driver="$(hostsh 'nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null | head -1')"
if [[ -n "$gpu_driver" ]]; then
  ml=/usr/lib/x86_64-linux-gnu
  for lib in libcuda libnvidia-ptxjitcompiler; do
    src="$(hostsh "readlink -f \"\$(ldconfig -p | awk '/$lib\\.so\\.1 /{print \$NF; exit}')\"")"
    [[ "$src" == *".so.$gpu_driver" ]] || {
      echo "certify: host $lib ($src) does not match driver $gpu_driver" >&2
      gpu_mount="" && break
    }
    gpu_mount="$gpu_mount -v $src:$ml/$lib.so.1:ro"
    [[ "$lib" == libcuda ]] && gpu_mount="$gpu_mount --device /dev/nvidia0 --device /dev/nvidiactl --device /dev/nvidia-uvm --device /dev/nvidia-uvm-tools"
    [[ "$lib" == libcuda ]] && gpu_mount="$gpu_mount -v $src:$ml/libcuda.so:ro"
  done
fi
# shellcheck disable=SC2086
docker run -d --name "$cname" --label org.cpp-standard.cert=1 $RUN_FLAGS $p2996_mount $gpu_mount "$image" sleep infinity >/dev/null || exit 2
tar -C "$scratch" -cf - probes 2>/dev/null | docker exec -i "$cname" tar -C /root -xf - 2>/dev/null

run_inner() { # run_inner ONLY SKIP: one pass of the in-container script
  docker exec -e MISE_AUTO_INSTALL=0 -e usage_only="$1" -e SKIP="$2" -e PROBES=/root/probes -e PIN="$pin" -e EXPECT_DIGEST="$digest" \
    -e IMAGE_BASE="$image_base" -e HOST_BINFMT_X86="$host_binfmt" -e HOST_ARCH="$host_arch" -e HOST_THREADS="$host_threads" \
    -e BUILD_DIR=/build "$cname" bash /root/probes/ubuntu-probes 2>/dev/null
}
# The other running containers on the host: "<ids> <usec> <unreadable>", with ids
# sorted and comma-joined, usec their total CPU time from cgroup v2, and
# unreadable the number of them whose cpu.stat could not be read.
others_cpu() {
  local ids all self
  # A failed listing is not "no other containers": print "? - -" (untrusted).
  all="$(docker ps -q --no-trunc)" && self="$(docker inspect -f '{{.Id}}' "$cname")" && [[ -n "$self" ]] || {
    echo "? - -"
    return
  }
  ids="$(grep -v "$self" <<<"$all" | sort | tr '\n' ' ')"
  [[ -z "${ids// /}" ]] && {
    echo "- 0 0"
    return
  }
  printf '%s ' "$(tr ' ' , <<<"${ids% }")"
  hostsh "s=0 m=0; for i in $ids; do f=/sys/fs/cgroup/system.slice/docker-\$i.scope/cpu.stat; \
    u=\$(awk '/^usage_usec/ {print \$2}' \$f 2>/dev/null); \
    if [ -n \"\$u\" ]; then s=\$((s + u)); else m=\$((m + 1)); fi; done; echo \$s \$m"
}
# cpu_trust BEFORE AFTER (two others_cpu snapshots): sets busy (ms of CPU the
# other containers used in between) and why (empty when the timings can be
# trusted: the same containers, every one accounted for, at most one CPU-second).
cpu_trust() {
  local c0 u0 m0 c1 u1 m1
  read -r c0 u0 m0 <<<"$1"
  read -r c1 u1 m1 <<<"$2"
  why=""
  [[ "$u0" =~ ^[0-9]+$ && "$u1" =~ ^[0-9]+$ && "$m0" == 0 && "$m1" == 0 ]] ||
    why="the CPU time of some containers could not be read"
  [[ "$c0" != "?" && "$c1" != "?" ]] || why="${why:+$why; }the container list could not be read"
  [[ "$c0" == "$c1" ]] || why="${why:+$why; }the set of other containers changed"
  [[ "$u0" =~ ^[0-9]+$ && "$u1" =~ ^[0-9]+$ && $u1 -lt $u0 ]] && why="${why:+$why; }a CPU counter went backwards"
  busy=0
  [[ "$u0" =~ ^[0-9]+$ && "$u1" =~ ^[0-9]+$ ]] && busy=$(((u1 - u0) / 1000))
  [[ $busy -gt 1000 ]] && why="${why:+$why; }over one CPU-second elsewhere"
  return 0
}

pass1_skip="$(echo "$TIMING_IDS" | tr ' ' ',')"
rc_inner=""
run_inner "$only" "$pass1_skip" >"$scratch/lines1.txt" || rc_inner="$rc_inner pass1:$?"
timing_only=""
for id in $TIMING_IDS; do want "$id" && timing_only="$timing_only,$id"; done
: >"$scratch/lines2.txt"
busy_note=""
if [[ -n "$timing_only" ]]; then
  s0="$(others_cpu)" l0="$(hostsh 'cut -d" " -f1 /proc/loadavg')"
  run_inner "${timing_only#,}" "" >"$scratch/lines2.txt" || rc_inner="$rc_inner pass2:$?"
  s1="$(others_cpu)" l1="$(hostsh 'cut -d" " -f1 /proc/loadavg')"
  cpu_trust "$s0" "$s1"
  busy_note="other containers used ${busy} ms CPU during the timing pass; host load ${l0} -> ${l1}${why:+ (untrusted: $why)}"
  if [[ -n "$why" ]]; then
    # Busy, or not fully accounted for: the timings are not trusted.
    awk '/^[A-Z][A-Z0-9]* +(PASS|FAIL|N\/A) +\[timing\]/ { id = $1; sub(/^[A-Z][A-Z0-9]* +(PASS|FAIL|N\/A) +\[timing\]/, "")
      printf "%-5s %-4s [timing untrusted: see the Timing pass line]%s\n", id, "N/A", $0; next } { print }' \
      "$scratch/lines2.txt" >"$scratch/lines2b.txt" && mv "$scratch/lines2b.txt" "$scratch/lines2.txt"
  fi
fi

# --- V6. host vs container A/B ------------------------------------------------------

: >"$scratch/lines3.txt"
if want V6; then
  if [[ "$local_docker" == true ]]; then
    printf '%-5s %-4s %s\n' V6 N/A "no host to compare against: the Docker host is Docker Desktop's Linux VM, not a machine that runs this toolchain natively (the Mac runs macOS)" >"$scratch/lines3.txt"
  elif [[ "${usage_ab:-false}" != true ]]; then
    printf '%-5s %-4s %s\n' V6 N/A "not run: pass --ab (writes a rootfs under /var/tmp on the Docker host)" >"$scratch/lines3.txt"
  else
    ab=/var/tmp/cpp-standard-cert-ab
    free_gb="$(hostsh "df -BG --output=avail /var/tmp | tail -1 | tr -dc 0-9")"
    # The workload: compile heavy.cpp, run bench (both from the appendix), on cores 2-5.
    docker exec "$cname" bash -c 'mkdir -p /ab && cp /root/probes/heavy.cpp /root/probes/bench.cpp /root/probes/hf_best.py /ab/ &&
      g++-16 -std=c++26 -O2 -march=x86-64-v3 /ab/bench.cpp -o /ab/bench' || exit 2
    cid="$(docker inspect -f '{{.Id}}' "$cname")"
    hostsh "rm -rf $ab && mkdir -p $ab/rootfs && docker export $cid | tar -C $ab/rootfs -xf - --exclude='./dev/*' 2>/dev/null; du -sm $ab | cut -f1" \
      >"$scratch/ab_size" || true
    meas='cd /ab && hyperfine -N -w 1 -r 5 --export-json /tmp/hf.json \
      "taskset -c 2-5 g++-16 -std=c++26 -O2 -c heavy.cpp -o /tmp/h.o" "taskset -c 2-5 ./bench" >/dev/null 2>&1 &&
      python3 -I hf_best.py /tmp/hf.json &&
      perf stat -x, -e instructions:u -- taskset -c 2-5 g++-16 -std=c++26 -O2 -c heavy.cpp -o /tmp/h.o 2>&1 >/dev/null | cut -d, -f1 &&
      perf stat -x, -e instructions:u -- taskset -c 2-5 ./bench 2>&1 >/dev/null | cut -d, -f1'
    # The host side gets the image's own environment (PATH, the mise config), so both
    # sides run the same binaries with the same settings.
    envs="$(docker image inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$image" |
      awk -F= 'NF > 1 { k = $1; sub(/^[^=]*=/, ""); printf " --setenv %s %s", k, $0 }')"
    bw="bwrap --unshare-user --uid 0 --gid 0 --bind $ab/rootfs / --proc /proc --dev /dev --tmpfs /tmp --ro-bind /sys /sys \
      --setenv HOME /root$envs --setenv MISE_AUTO_INSTALL 0 --chdir /ab"
    s0="$(others_cpu)"
    : >"$scratch/ab_c" && : >"$scratch/ab_h"
    for _ in 1 2 3; do # alternate the two sides
      docker exec -e MISE_AUTO_INSTALL=0 "$cname" bash -c "$meas" | tr '\n' ' ' >>"$scratch/ab_c" && echo >>"$scratch/ab_c"
      hostsh "$bw bash -c '$meas'" | tr '\n' ' ' >>"$scratch/ab_h" && echo >>"$scratch/ab_h"
    done
    s1="$(others_cpu)"
    hostsh "rm -rf $ab; test -e $ab && echo still-there || echo removed" >"$scratch/ab_rm"
    cpu_trust "$s0" "$s1"
    # Best (minimum) wall time per side over 3 rounds; overhead in % of the host's.
    # -B: no .pyc written into the Mac's mise python install (rule 4 proof).
    python3 -I -B - "$scratch/ab_c" "$scratch/ab_h" "$busy" "$(cat "$scratch/ab_size")" "$free_gb" "$(cat "$scratch/ab_rm")" "$why" \
      >"$scratch/lines3.txt" <<'PY'
import sys
def rows(p):
    return [list(map(int, l.split())) for l in open(p) if len(l.split()) == 4]
c, h = rows(sys.argv[1]), rows(sys.argv[2])
busy, size, free, rm, why = int(sys.argv[3]), sys.argv[4], sys.argv[5], sys.argv[6], sys.argv[7]
if len(c) < 3 or len(h) < 3:
    print(f"V6    FAIL [timing] incomplete A/B: container {len(c)} rounds, host {len(h)}; rootfs {rm}")
    sys.exit()
cc, cb = min(r[0] for r in c), min(r[1] for r in c)
hc, hb = min(r[0] for r in h), min(r[1] for r in h)
oc, ob = (cc - hc) / hc * 100, (cb - hb) / hb * 100
ic = "same" if c[0][2] == h[0][2] else f"{c[0][2]} vs {h[0][2]}"
ib = "same" if c[0][3] == h[0][3] else f"{c[0][3]} vs {h[0][3]}"
ev = (f"[timing] compile {cc} vs {hc} ms ({oc:+.1f}%), bench {cb} vs {hb} ms ({ob:+.1f}%) container vs host, best of 3x5; "
      f"instructions:u compile {ic}, bench {ib}; rootfs {size} MB of {free} GB free, {rm}; others {busy} ms CPU")
status = "PASS" if oc <= 2.0 and ob <= 2.0 and rm == "removed" else "FAIL"
if why:
    status, ev = "N/A ", f"[timing untrusted: {why}] " + ev
print(f"V6    {status} {ev}"[:250].rstrip())
PY
  fi
fi

# --- Report ---------------------------------------------------------------------

order="$(grep -oE '^\*\*[A-Z]+[0-9]+\.' "$doc" | tr -d '*.' | tr '\n' ' ')"
cat "$scratch/lines1.txt" "$scratch/lines2.txt" "$scratch/lines3.txt" | grep -v '^HDR ' >"$scratch/all.txt"
: >"$scratch/body.txt"
# Exactly one result per selected check: a probe pass that died early, or a
# check that printed twice, is a FAIL, never a shorter report.
for id in $order; do
  want "$id" || continue
  n="$(grep -cE "^$id +" "$scratch/all.txt")"
  if [[ $n == 1 ]]; then
    grep -E "^$id +" "$scratch/all.txt" >>"$scratch/body.txt"
  else
    printf '%-5s %-4s %s\n' "$id" FAIL "$n results (want 1): the probe pass ended early or repeated a check${rc_inner:+; exit status$rc_inner}" >>"$scratch/body.txt"
  fi
done
hdr() { grep -m1 "^HDR $1=" "$scratch/lines1.txt" | cut -d= -f2-; }
npass="$(grep -cE '^[A-Z0-9]+ +PASS' "$scratch/body.txt")"
nfail="$(grep -cE '^[A-Z0-9]+ +FAIL' "$scratch/body.txt")"
nna="$(grep -cE '^[A-Z0-9]+ +N/A' "$scratch/body.txt")"

fix_for() {
  case "$1" in
    A2) echo "rebuild the image from docs/standard/ubuntu-cert.Dockerfile (mise run certify:ubuntu-image)" ;;
    A3) echo "run on the amd64 PC; never under qemu" ;;
    B2) echo "remove the archive clang (it comes with the archive iwyu; ubuntu-cert.Dockerfile leaves it out); for a stray mise shim, pin the tool in the image's tools layer (docs/standard/ubuntu-cert-tools) or drop it" ;;
    E2) echo "clangd matching clang-23 needs llvmorg-23.1.6 or an apt.llvm.org stonking suite (D25)" ;;
    P8) echo "rebuild p2996 with build-linux.sh (it builds IWYU 0.25 in the tree) into volume $p2996_vol (docs/standard/ubuntu.md, P8)" ;;
    P*) echo "build p2996 for amd64 and mount it as volume $p2996_vol (docs/standard/ubuntu.md, P)" ;;
    DB4 | DB5) echo "the p2996 install (P)" ;;
    GO*) echo "the host NVIDIA driver (nvidia-smi on the Docker host), the image's CUDA toolkits and offload runtimes (mise run certify:ubuntu-image), and the p2996 install for GO1 (docs/standard/ubuntu.md, GO)" ;;
    T3) echo "rebuild the image (mise run certify:ubuntu-image; stage iwyu builds IWYU 0.27); if the LLVM 23 snapshot is gone, move LLVM_VER and recertify (docs/standard/ubuntu.md, T3)" ;;
    V2) echo "run the container with --cap-add PERFMON and docs/standard/ubuntu-seccomp.json (certify:ubuntu does)" ;;
    *) echo "see $1 in docs/standard/ubuntu.md" ;;
  esac
}
report() {
  printf 'Ubuntu certification  %s  %s\n' "$label" "$(date +%F)"
  printf '%s  kernel %s (container on %s)  glibc %s\n' "$(hdr os)" "$(hdr kernel)" "$host_kernel_desc" "$(hdr glibc)"
  printf 'CPU %s  Docker %s  image %s\n' "$(hdr cpu)" "$docker_ver" "${image_id:7:12}"
  printf 'docker run flags: %s%s%s\n' "${RUN_FLAGS//"$root"\//}" "${p2996_mount:+ -v $p2996_vol:/opt/p2996:ro}" "${gpu_mount:+ (+ the 4 NVIDIA compute device nodes and host NVIDIA driver $gpu_driver: libcuda, libnvidia-ptxjitcompiler, read-only)}"
  [[ -n "$busy_note" ]] && printf 'Timing pass: %s\n' "$busy_note"
  [[ -n "$rc_inner" ]] && printf 'Probe passes exited non-zero:%s (the report is incomplete)\n' "$rc_inner"
  printf '[host kernel] marks a kernel-dependent check: it ran in a container on %s, not Ubuntu'"'"'s.\n' "$host_kernel_desc"
  cat "$scratch/body.txt"
  printf 'Summary: %d PASS, %d FAIL, %d N/A\n' "$npass" "$nfail" "$nna"
  printf 'mise installs (this Mac): %s\n' "$inst_note"
  printf 'Missing or wrong:'
  ids="$(grep -E '^[A-Z0-9]+ +FAIL' "$scratch/body.txt" | awk '{print $1}')"
  if [[ -z "$ids" ]]; then printf ' none\n'; else
    printf '\n'
    for id in $ids; do printf '  %s: %s\n' "$id" "$(fix_for "$id")"; done
  fi
}

if [[ $((npass + nfail + nna)) == 0 ]]; then
  echo "certify: --only '$only' matched no check" >&2
  exit 2
fi
inst_after="$(inst_list)"
inst_diff() { # inst_diff COMM-FLAG FILE1 FILE2 LABEL: comm's lines, labelled
  LC_ALL=C comm "$1" "$2" "$3" | sed "s#\$# ($4)#"
}
# Added and removed paths, then files modified in place (folders change only
# by an entry added or removed, which the walks name). Any failed step makes
# the result unknown, which counts as a change (exit 3), never as unchanged.
if ! inst_walk >"$inst_mark.end" || ! inst_new="$(
  inst_diff -13 "$inst_mark.start" "$inst_mark.end" added &&
    inst_diff -23 "$inst_mark.start" "$inst_mark.end" removed &&
    inst_walk ! -type d -newer "$inst_mark" | inst_diff -12 "$inst_mark.start" - modified
)"; then
  inst_new="$inst_dir/<cannot compare the walks of the pinned tools> (unknown)"
fi
[[ -z "$inst_new" ]] || inst_after+=$'\n'"$inst_new"
rm -f "$inst_mark" "$inst_mark.start" "$inst_mark.end"
if [[ "$inst_after" == "$inst_before" ]]; then
  inst_note="unchanged ($(grep -c . <<<"$inst_after") pinned tool folders)"
else
  inst_note="CHANGED during the run (by this run or another process; rerun when nothing else installs): $(diff <(printf '%s\n' "$inst_before") <(printf '%s\n' "$inst_after") | sed -n "s#^\([<>]\) $inst_dir/#\1 #p" | tr '\n' ' ')"
fi
report | mask
[[ -n "$out" ]] && report | mask >"$out"
[[ "$inst_after" == "$inst_before" ]] || exit 3
[[ -z "$rc_inner" ]] || exit 1
[[ $nfail == 0 || "${usage_allow_fail:-false}" == true ]]
