fi
if want T3; then
  # clang 23 projects: IWYU 0.27 built against the LLVM 23 tarball
  # (toolchain:iwyu-llvm23), on the tarball's exact clang version, with the
  # SDK mapping the build writes; it must flag an unused <vector> with no
  # error, keep <cstdio> for puts and <clocale> for newlocale, and name no
  # private header (<_stdio.h>, <_locale_posix2008.h>) in its include list.
  # Reflection projects: P8's.
  t3_imp="${IWYU23%/bin/*}/share/include-what-you-use/macos-sdk.imp"
  hv="$(tmo 30 "$IWYU23" --version 2>&1)"
  hrc=$?
  hv1="$(printf '%s\n' "$hv" | head -1)"
  cv="$("$LLVM23/bin/clang" --version 2>/dev/null | head -1 | sed -E 's/^.*(clang version [^ ]+).*$/\1/')"
  printf '#include <vector>\n#include <cstdio>\n#include <clocale>\nint main(){std::puts("x"); locale_t l=newlocale(LC_ALL_MASK,"C",nullptr); freelocale(l);}\n' >t3.cpp
  io="$(tmo 60 "$IWYU23" -std=c++26 -Xiwyu --mapping_file="$LLVM23/include/c++/v1/libcxx.imp" \
    -Xiwyu --mapping_file="$t3_imp" t3.cpp 2>&1)"
  irc=$? # IWYU 0.27 exits 0 after printing its suggestions
  [[ "$p8_msg" == unset ]] && p8_eval
  if [[ $hrc == 0 && "$hv" == *"include-what-you-use 0.27"* && -n "$cv" && "$hv" == *"$cv "* &&
    $irc == 0 && "$io" == *"should remove these lines"*"#include <vector>"* && "$io" != *"error:"* &&
    "$io" == *"full include-list"*"#include <cstdio>"*"// for puts"* &&
    "$io" == *"full include-list"*"#include <clocale>"*"newlocale"* && "$io" != *"#include <_"* ]]; then
    t3_23="PASS (${hv1%% (http*}; unused <vector> flagged; <cstdio>, <clocale> kept)"
  elif [[ $hrc != 0 || "$hv" != *"include-what-you-use 0.27"* || -z "$cv" || "$hv" != *"$cv "* ]]; then
    t3_23="FAIL: exit $hrc: ${hv1%% (http*} (want 0.27 on ${cv:-the tarball clang})"
  else
    t3_23="FAIL: sample exit $irc: $(grep -m1 -E 'error:|Assertion|#include <_|should remove' <<<"$io" || echo no verdict)"
  fi
  # The p2996 half first: res cuts the evidence at 240 characters.
  t3_p="p2996: P8 $([[ $p8_ok == yes ]] && echo PASS || echo 'not PASS')"
  if [[ "$t3_23" == PASS* && $p8_ok == yes ]]; then
    res T3 PASS "$t3_p; clang 23: $t3_23"
  else
    res T3 FAIL "$t3_p; clang 23: $t3_23"
  fi
fi
if want T4; then
