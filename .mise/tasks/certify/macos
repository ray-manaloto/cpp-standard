# --- T. Analysis -------------------------------------------------------------

want T1 && res T1 N/A "rule: \$LLVM23 tools for plain projects, -p2996 tools for reflection projects (P7)"
if want T2; then
  o="$(tmo 30 "$P2996/bin/scan-build-p2996" --help 2>&1)"
