# reports, and every result checked. They are host checks: the toolchains
# are built on the host (toolchain:acpp-metal), not in the guest.
for id in GO1 GO2 GO3; do want $id && res $id N/A "no Apple GPU target in clang or GCC; libomptarget does not build on macOS"; done
# On hold (owner, 2026-11-16): nothing is built, so GO4-GO7 report N/A.
# Set go_hold=no to turn the probes below back on.
go_hold=yes
acpp_pin="$(grep -oE 'AdaptiveCpp commit \(today `[0-9a-f]{40}' "$doc" | grep -oE '[0-9a-f]{40}' | head -1)"
if [[ "$go_hold" == yes ]]; then
  for id in GO4 GO5 GO6 GO7; do want $id && res $id N/A "on hold (owner, 2026-11-16), see research/apple-gpu-offload.md"; done
elif [[ "$in_vm" == 1 ]]; then
  for id in GO4 GO5 GO6 GO7; do want $id && res $id N/A "host check: the Apple GPU toolchains are built and certified on the host"; done
else
  # Every acpp run keeps its JIT cache (app db) and the compiler's temporary
  # files in the scratch dir (rule 4).
  export ACPP_APPDB_DIR="$PROBE/acpp-appdb"
  acpp_tmp="$PROBE/acpp-tmp"
  mkdir -p "$acpp_tmp"
  acpp_ok=no
  if [[ ! -x "$ACPP/bin/acpp" ]]; then
    acpp_msg="no AdaptiveCpp at \$ACPP ($ACPP; mise run toolchain:acpp-metal)"
  else
    ai="$(tmo 60 "$ACPP/bin/acpp-info" -l 2>&1)"
    inputs="$(cat "$ACPP/share/acpp-metal-inputs.txt" 2>/dev/null)"
    dev="$(sed -n 's/^ *Found device: //p' <<<"$(sed -n '/Loaded backend .*: Metal/,$p' <<<"$ai")" | head -1)"
    if [[ -z "$acpp_pin" || "$inputs" != *"acpp $acpp_pin"* ]]; then
      acpp_msg="built from ${inputs%%$'\n'*} (want acpp ${acpp_pin:-<no pin in the playbook>})"
    elif [[ "$ai" != *"Loaded backend"*": Metal"* || "$dev" != Apple* ]]; then
      acpp_msg="acpp-info lists no Metal device: $(grep -m2 -E 'backend|device' <<<"$ai" | tr '\n' ' ')"
    else
      acpp_ok=yes acpp_msg="acpp ${acpp_pin:0:12}, Metal device: $dev"
    fi
  fi
  if want GO4; then
    [[ $acpp_ok == yes ]] && res GO4 PASS "$acpp_msg" || res GO4 FAIL "$acpp_msg"
  fi
  if want GO5; then
    if [[ $acpp_ok != yes ]]; then res GO5 FAIL "not run: GO4: $acpp_msg"; else
      o="$(TMPDIR="$acpp_tmp" tmo 600 "$ACPP/bin/acpp" -O2 acpp_sycl.cpp -o acpp_sycl 2>&1 && TMPDIR="$acpp_tmp" tmo 120 ./acpp_sycl 2>&1)"
      rc=$?
      d="$(sed -n 's/^device: //p' <<<"$o" | head -1)" r="$(grep -m1 '^sycl: ' <<<"$o")"
      if [[ $rc == 0 && "$d" == Apple*"(Metal"* && "$r" == "sycl: 0/"*" wrong" ]]; then
        res GO5 PASS "kernel ran on $d; $r"
      else res GO5 FAIL "exit $rc: ${d:-no device line}; ${r:-$(grep -m1 -E 'error|exception' <<<"$o")}"; fi
    fi
  fi
  if want GO6; then
    if [[ $acpp_ok != yes ]]; then res GO6 FAIL "not run: GO4: $acpp_msg"; else
      # Unconditional offload: without it the runtime may choose the host.
      o="$(TMPDIR="$acpp_tmp" tmo 600 "$ACPP/bin/acpp" -O2 --acpp-stdpar --acpp-stdpar-unconditional-offload acpp_stdpar.cpp -o acpp_stdpar 2>&1)"
      rc=$?
      if [[ $rc != 0 && "$o" == *"'pstl/execution_defs.h' file not found"* ]]; then
        res GO6 FAIL "known upstream (stdpar needs libstdc++, doc/stdpar.md:8; the Mac has libc++): $(grep -m1 'fatal error' <<<"$o" | sed 's#^.*/stdpar/#stdpar/#')"
      elif [[ $rc != 0 ]]; then
        res GO6 FAIL "compile exit $rc: $(grep -m1 -E 'error' <<<"$o")"
      else
        # Proof of GPU execution: the Metal queue logs each kernel it submits
        # ("metal_queue: Submitting kernel...", src/runtime/metal/metal_queue.cpp:734).
        o="$(TMPDIR="$acpp_tmp" ACPP_DEBUG_LEVEL=3 tmo 120 ./acpp_stdpar 2>&1)"
        rc=$?
        r="$(grep -m1 '^stdpar: ' <<<"$o")"
        k="no"
        [[ "$o" == *"metal_queue: Submitting kernel"* ]] && k="yes"
        if [[ $rc == 0 && "$r" == "stdpar: 0/"*" wrong" && $k == yes ]]; then
          res GO6 PASS "std::transform ran as a Metal kernel (metal_queue submitted it); $r"
        else res GO6 FAIL "exit $rc: ${r:-no result line}; Metal kernel submitted: $k"; fi
      fi
    fi
  fi
  if want GO7; then
    # chipStar (CUDA/HIP) on the Apple GPU: upstream's route is its native
    # Vulkan backend on Mesa KosmicKrisp, which needs LLVM 24+. Not built yet.
    CHIPSTAR="${CHIPSTAR:-${XDG_DATA_HOME:-$HOME/.local/share}/chipstar/current}"
    if [[ ! -x "$CHIPSTAR/bin/hipcc" ]]; then
      res GO7 FAIL "chipStar not built (\$CHIPSTAR: $CHIPSTAR): its Apple-GPU route needs LLVM 24+ and Mesa KosmicKrisp (research note)"
    else res GO7 FAIL "chipStar found at $CHIPSTAR, but this playbook has no probe for it yet"; fi
  fi
fi

# --- V. Tart -----------------------------------------------------------------

if [[ "$in_vm" == 1 ]]; then
  for id in V1 V2; do want $id && res $id N/A "host check"; done
  # V3 means every section ran in the guest: only a full run can say so.
  if want V3; then
    if [[ "$only" != ",," ]]; then
      res V3 N/A "needs a full run without --only"
    elif [[ $((nfail - n_known)) == 0 ]]; then
      res V3 PASS "full in-guest run, no FAIL above except known upstream"
    else res V3 FAIL "full in-guest run: $((nfail - n_known)) checks failed above (not counting known upstream)"; fi
  fi
else
  tv="$(tart --version 2>/dev/null)"
  if want V1; then
    # Tart must be mise-managed: the pin in .mise/conf.d/vm.toml (it wins over
    # the dotfiles global pin inside this repository), and `tart` on PATH must
    # be that install, not Homebrew's or another copy.
    # The probes run in the scratch dir; mise must read this repository's config.
    tj="$(mise -C "$root" ls tart --json 2>/dev/null)"
    pin_sel='[.[] | select((.source.path // "") | endswith("/.mise/conf.d/vm.toml"))][0]'
    want_tv="$(jq -r "$pin_sel.requested_version // empty" <<<"$tj" 2>/dev/null)"
    want_dir="$(jq -r "$pin_sel.install_path // empty" <<<"$tj" 2>/dev/null)"
    # From /, mise reads only the global config; an entry without a source is an install nothing pins.
    glob_tv="$(mise -C / ls tart --json 2>/dev/null | jq -r '[.[] | select(.source.path)][0].requested_version // empty' 2>/dev/null)"
    tbin="$(command -v tart 2>/dev/null || true)"
    mbin="$(mise -C "$root" which tart 2>/dev/null || true)"
    gnote=""
    [[ -n "$glob_tv" && "$glob_tv" != "$want_tv" ]] && gnote="; dotfiles global pin $glob_tv differs"
    [[ -z "$glob_tv" ]] && gnote="; no dotfiles global pin"
    if [[ -z "$want_tv" ]]; then
      res V1 FAIL "no tart pin in .mise/conf.d/vm.toml"
    elif [[ -z "$tv" ]]; then
      res V1 FAIL "tart $want_tv (mise pin) not installed$gnote"
    elif [[ "$tv" != "$want_tv" || -z "$mbin" || "$mbin" != "$want_dir"/* || ("$tbin" != "$mbin" && "$tbin" != */mise/shims/tart) ]]; then
      res V1 FAIL "tart $tv at ${tbin:-?} is not the mise pin $want_tv${gnote}"
    else
      res V1 PASS "tart $tv from mise (pin in .mise/conf.d/vm.toml)$gnote"
    fi
  fi
  if want V2; then
    dg="$(grep -A2 '^Digest on ' "$doc" | grep -oE 'sha256:[0-9a-f]{64}' | head -1)" # V2's digest line
    if [[ -z "$tv" ]]; then res V2 FAIL "not run: Tart not installed (V1)"; else
      tart list 2>/dev/null | grep -q "golden-gate-xcode.*${dg#sha256:}" && res V2 PASS "pulled by $dg" ||
        res V2 FAIL "no golden-gate-xcode image pulled by $dg"
    fi
  fi
  want V3 && res V3 N/A "VM check: run this task inside the guest"
fi

# --- Report ------------------------------------------------------------------

fix_for() {
  case "$1" in
    A3) echo "sudo xcodebuild -runFirstLaunch; sudo xcodebuild -license accept" ;;
    A6) echo "sudo DevToolsSecurity -enable (DB5 step 5)" ;;
    B2) echo "uninstall the inactive mise tools behind the stray shims (mise uninstall <tool>; mise reshim)" ;;
    C2) echo "install the LLVM 23 tarball with mise (D38); after an Xcode or xcode-select change: mise install --force github:llvm/llvm-project" ;;
    C9) echo "run through mise in this repository (.mise/conf.d/llvm.toml puts the tarball first)" ;;
    C[1-8] | DB2) echo "install the LLVM 23 tarball with mise (D38)" ;;
    G1 | G3) echo "the GCC 16.2 source build (D33)" ;;
    G4 | G6) echo "put /usr/bin before Homebrew LLVM on PATH for GCC builds (G6)" ;;
    P6) echo "rebuild p2996 with LLVM_INSTALL_UTILS=ON" ;;
    P8) echo "build IWYU (branch clang_21) against p2996" ;;
    T3) echo "mise run toolchain:iwyu-llvm23 (IWYU 0.27 against the LLVM 23 tarball); for the p2996 half, P8" ;;
    P10) echo "known upstream: use Apple ld until p2996 moves to an LLVM whose lld reads the SDK" ;;
    GO4 | GO5) echo "mise run toolchain:acpp-metal (AdaptiveCpp with the Metal backend, against LLVM 21.1.8)" ;;
    GO6) echo "known upstream: AdaptiveCpp stdpar supports only libstdc++ (doc/stdpar.md:8); use SYCL (GO5) on the Mac" ;;
    GO7) echo "build chipStar on its native Vulkan backend over Mesa KosmicKrisp (research note, section 3)" ;;
    L1 | L2 | R4) echo "see the check; clang 23 parts need the LLVM 23 tarball" ;;
    V1) echo "install Tart with mise (mise install tart; pinned in .mise/conf.d/vm.toml and in the dotfiles global config); remove any Homebrew tart" ;;
    V2) echo "tart pull the golden-gate-xcode image by its digest" ;;
    *) echo "see $1 in docs/standard/macos.md" ;;
  esac
}

inst_after="$(inst_list)"
inst_diff() { # inst_diff COMM-FLAG FILE1 FILE2 LABEL: comm's lines, labelled
  LC_ALL=C comm "$1" "$2" "$3" | sed "s#\$# ($4)#"
}
# Added and removed paths, then files modified in place (folders change only
# by an entry added or removed, which the walks name). Any failed step makes
# the result unknown, which counts as a change (exit 3), never as unchanged.
if ! inst_walk >"$inst_mark.end" || ! inst_new="$(
  inst_diff -13 "$inst_mark.start" "$inst_mark.end" added &&
    inst_diff -23 "$inst_mark.start" "$inst_mark.end" removed &&
    inst_walk ! -type d -newer "$inst_mark" | inst_diff -12 "$inst_mark.start" - modified
)"; then
  inst_new="$inst_dir/<cannot compare the walks of the pinned tools> (unknown)"
fi
[[ -z "$inst_new" ]] || inst_after+=$'\n'"$inst_new"
rm -f "$inst_mark" "$inst_mark.start" "$inst_mark.end"
if [[ "$inst_after" == "$inst_before" ]]; then
  inst_note="unchanged ($(grep -c . <<<"$inst_after") pinned tool folders)"
else
  inst_note="CHANGED during the run (by this run or another process; rerun when nothing else installs): $(diff <(printf '%s\n' "$inst_before") <(printf '%s\n' "$inst_after") | sed -n "s#^\([<>]\) $inst_dir/#\1 #p" | tr '\n' ' ')"
fi

report() {
  printf 'macOS certification  %s  %s\n' "$label" "$(date +%F)"
  printf 'macOS %s  %s  SDK %s\n' "$os_ver" "$xcode_ver" "$sdk_ver"
  cat "$body"
  printf 'Summary: %d PASS, %d FAIL, %d N/A\n' "$npass" "$nfail" "$nna"
  printf 'Known upstream (do not fail strict mode):%s\n' "${known_ids:- none}"
  printf 'mise installs: %s\n' "$inst_note"
  printf 'Missing or wrong:'
  if [[ -z "$failed_ids" ]]; then printf ' none\n'; else
    printf '\n'
    for id in $failed_ids; do printf '  %s: %s\n' "$id" "$(fix_for "$id")"; done
  fi
}

if [[ $((npass + nfail + nna)) == 0 ]]; then
  echo "certify: --only '${usage_only:-}' matched no check" >&2
  exit 2
fi
report
[[ -n "$out" ]] && report >"$out"
[[ "$inst_after" == "$inst_before" ]] || exit 3
[[ $((nfail - n_known)) == 0 || "${usage_allow_fail:-false}" == true ]]
