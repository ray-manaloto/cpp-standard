  pp="$("$P" -std=c++26 -freflection-latest -E -P l3.cpp 2>/dev/null | tail -1)"
  [[ "$gp" == REFL_YES && "$pp" == REFL_YES ]] && res L3 PASS "the two-part guard matches on GCC 16 and p2996" ||
    res L3 FAIL "gcc16 $gp; p2996 $pp"
fi

