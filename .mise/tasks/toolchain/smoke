#!/usr/bin/env bash
#MISE description="Compile and run the stand-in module's test with an installed toolchain (no preset yet)"
#USAGE arg "<prefix>" help="The toolchain's install prefix, as toolchain:fetch prints it"
#
# The gate's toolchain smoke step (ticket #130). Until M1a PR 4 adds the p2996 preset it is a plain
# CMake build of the project with the installed clang++ and its own libc++, in build/toolchain-smoke,
# then ctest. The gate's presets and coverage stay with `mise run ci`.
set -euo pipefail
root="${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"
prefix="${usage_prefix:?}"
cxx="$prefix/bin/clang++"
triple="$("$cxx" -print-target-triple)"
build="$root/build/toolchain-smoke"
rm -rf "$build"
"$cxx" --version | head -1
cmake -G Ninja -S "$root" -B "$build" \
  -DCMAKE_BUILD_TYPE=Debug \
  -DCMAKE_CXX_COMPILER="$cxx" \
  -DCMAKE_CXX_FLAGS=-stdlib=libc++ \
  -DCMAKE_EXE_LINKER_FLAGS="-stdlib=libc++ -Wl,-rpath,$prefix/lib/$triple"
cmake --build "$build"
ctest --test-dir "$build" --output-on-failure
echo "PASS: the stand-in module's test with $cxx"
