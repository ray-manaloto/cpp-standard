#!/usr/bin/env bash
#MISE description="Run python/gate's unit tests under coverage; fail below its floor (#185)"
set -euo pipefail
# A git hook exports GIT_DIR, GIT_WORK_TREE, GIT_INDEX_FILE and the rest; clear them so a test or fixture's
# scratch `git init` or `git commit` cannot reach the real repository (#280).
# shellcheck disable=SC2046
unset $(git rev-parse --local-env-vars)
root="$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"
cd "$root"
data="$(mktemp -d)"
trap 'rm -rf "$data"' EXIT
export COVERAGE_FILE="$data/.coverage"
rc=python/gate/pyproject.toml
cov=(uv run --no-project --quiet --with coverage==7.17.3 python -I -m coverage)
# The same tests as the checklist's mapping and the checker's cases; the workflow shape included.
"${cov[@]}" run --rcfile="$rc" tests/gate/test_checklist.py
"${cov[@]}" run --rcfile="$rc" python/gate/checklist.py --help >/dev/null
"${cov[@]}" combine --rcfile="$rc" --quiet "$data"
"${cov[@]}" report --rcfile="$rc"
