# Toolchains fetched or staged by toolchain:fetch and workflow steps.
.cache/
# Artifacts written by artifact:build.
dist/
# Local devcontainer settings; never committed.
.devcontainer/.env

# Per-machine links that mise makes to tool skills (D102). Project skills
# live under .agents/skills/; .claude/skills/ holds only committed links to
# them, so Claude Code finds them as slash commands.
.agents/skills/.mise-skills.json
.agents/skills/hk-*
/.claude/skills/*
!/.claude/skills/egm-check
