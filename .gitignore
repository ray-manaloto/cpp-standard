# Toolchains fetched or staged by toolchain:fetch and workflow steps.
.cache/
# Artifacts written by artifact:build.
dist/
# Local devcontainer settings; never committed.
.devcontainer/.env

# Per-machine links that mise makes to tool skills (D102). Project skills
# live under .agents/skills/; .claude/skills/ holds committed links to them,
# so Claude Code finds them as slash commands.
.agents/skills/.mise-skills.json
# Ignore every entry, then un-ignore each tracked project skill (a new one needs its line; the
# repo:skill-links-check step fails without it) (#294).
.agents/skills/*
!.agents/skills/egm-check
!.agents/skills/macos-certify
!.agents/skills/pins-apt-bump
!.agents/skills/run-testtab
!.agents/skills/ubuntu-arm64-run
!.agents/skills/ubuntu-certify

# The ticket roadmap that /to-spec and /to-tickets keep in the main checkout. It is rebuilt from GitHub
# (workflowtools tickets --rebuild), so it is local state, not a source file.
/task_plan.md

# CMake build trees, one per preset (build/<preset>).
/build/

# repotools and workflowtools (python/repo, python/workflow): their venvs and what their tests leave. Here, not in
# the packages, so the copied files stay dotfiles' own (#154).
/python/repo/.venv/
/python/workflow/.venv/
__pycache__/
.coverage
# A subprocess writes its own .coverage.<host>.pid<n>.<random> until pytest-cov combines them.
.coverage.*
.pytest_cache/
.ruff_cache/

# Generated TypeScript config in each claude-mods package.
/unix/home/.local/share/claude-mods/*/tsconfig.json
