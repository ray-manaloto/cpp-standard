{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "workflowtools",
  "type": "object",
  "additionalProperties": false,
  "description": "Types of the workflow checks; mise run //workflow:codegen writes src/workflowtools/models.py from this file.",
  "properties": {
    "command": {
      "$ref": "#/$defs/Command"
    },
    "frontmatter": {
      "$ref": "#/$defs/Frontmatter"
    },
    "skill_table": {
      "$ref": "#/$defs/SkillTable"
    },
    "listing": {
      "$ref": "#/$defs/Listing"
    },
    "tickets": {
      "$ref": "#/$defs/Tickets"
    },
    "settings_local": {
      "$ref": "#/$defs/SettingsLocal"
    },
    "options": {
      "$ref": "#/$defs/Options"
    },
    "check": {
      "$ref": "#/$defs/Check"
    },
    "finding": {
      "$ref": "#/$defs/Finding"
    },
    "skipped": {
      "$ref": "#/$defs/Skipped"
    },
    "failure": {
      "$ref": "#/$defs/Failure"
    },
    "skill_frontmatter": {
      "$ref": "#/$defs/SkillFrontmatter"
    },
    "okf_frontmatter": {
      "$ref": "#/$defs/OkfFrontmatter"
    },
    "plugin_manifest": {
      "$ref": "#/$defs/PluginManifest"
    },
    "plugin_record": {
      "$ref": "#/$defs/PluginRecord"
    },
    "installed_plugins": {
      "$ref": "#/$defs/InstalledPlugins"
    },
    "issue_state": {
      "$ref": "#/$defs/IssueState"
    },
    "github_issue": {
      "$ref": "#/$defs/GitHubIssue"
    },
    "issue_ticket": {
      "$ref": "#/$defs/IssueTicket"
    },
    "plan_resolved": {
      "$ref": "#/$defs/PlanResolved"
    },
    "unavailable": {
      "$ref": "#/$defs/Unavailable"
    },
    "round_open": {
      "$ref": "#/$defs/RoundOpen"
    },
    "round_pr": {
      "$ref": "#/$defs/RoundPr"
    },
    "round_close": {
      "$ref": "#/$defs/RoundClose"
    },
    "report": {
      "$ref": "#/$defs/Report"
    },
    "round_event": {
      "$ref": "#/$defs/RoundEvent"
    },
    "github_pull": {
      "$ref": "#/$defs/GitHubPull"
    },
    "open_round": {
      "$ref": "#/$defs/OpenRound"
    },
    "report_section": {
      "$ref": "#/$defs/ReportSection"
    },
    "round_retro": {
      "$ref": "#/$defs/RoundRetro"
    },
    "retro_owed": {
      "$ref": "#/$defs/RetroOwed"
    }
  },
  "$defs": {
    "Command": {
      "description": "The workflowtools subcommands, one per mise task.",
      "type": "string",
      "enum": [
        "frontmatter",
        "skill-table",
        "tickets",
        "settings-local",
        "round-open",
        "round-pr",
        "round-close",
        "round-retro",
        "report"
      ]
    },
    "RoundId": {
      "description": "<repo-or-lane>-<yyyymmdd>-<slug>; the part before the first -<8 digits>- names the lane's store file.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*-[0-9]{8}-[a-z0-9][a-z0-9-]*$"
    },
    "Repo": {
      "description": "A GitHub repository, owner/name; never . or .., since it goes into a gh api path.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+/\\.?[A-Za-z0-9_-][A-Za-z0-9_.-]*$"
    },
    "RoundOpen": {
      "description": "Open a round; a replay prints the stored open event and writes nothing.",
      "type": "object",
      "properties": {
        "round": {
          "$ref": "#/$defs/RoundId"
        }
      },
      "required": [
        "round"
      ],
      "additionalProperties": false
    },
    "RoundPr": {
      "description": "Add a pull request to an open round; a replay prints the stored pr event and writes nothing.",
      "type": "object",
      "properties": {
        "round": {
          "$ref": "#/$defs/RoundId"
        },
        "repo": {
          "$ref": "#/$defs/Repo"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "round",
        "repo",
        "number"
      ],
      "additionalProperties": false
    },
    "RoundClose": {
      "description": "Close a round with the retro's inputs and each pull request's head commit read from GitHub now.",
      "type": "object",
      "properties": {
        "round": {
          "$ref": "#/$defs/RoundId"
        },
        "session": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "description": "A session that did the work; repeat the flag for each"
        },
        "plan": {
          "type": "string",
          "minLength": 1,
          "description": "The plan or lane page the retro starts from"
        }
      },
      "required": [
        "round",
        "session",
        "plan"
      ],
      "additionalProperties": false
    },
    "RoundRetro": {
      "description": "Record a closed round's retro; a replay prints the stored retro event and writes nothing.",
      "type": "object",
      "properties": {
        "round": {
          "$ref": "#/$defs/RoundId"
        },
        "source": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "description": "A source the retro actually read (session, plan, pull request); repeat the flag for each"
        },
        "findings": {
          "type": "integer",
          "minimum": 0,
          "description": "How many findings the retro made; zero is valid"
        },
        "findings_at": {
          "type": "string",
          "minLength": 1,
          "description": "Where the findings live, such as the plan's findings.md or a ticket comment"
        },
        "accepted": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [],
          "description": "A proposed change the owner accepted; repeat the flag for each"
        },
        "declined": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [],
          "description": "A proposed change the owner declined; repeat the flag for each"
        },
        "later": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [],
          "description": "A proposed change kept for later; repeat the flag for each"
        }
      },
      "required": [
        "round",
        "source",
        "findings",
        "findings_at"
      ],
      "additionalProperties": false
    },
    "Report": {
      "description": "Print open rounds and closed rounds owing a retro; each section is unknown when the store cannot be read.",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "OpenEvent": {
      "description": "A round was opened.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "open"
        },
        "round": {
          "$ref": "#/$defs/RoundId"
        },
        "at": {
          "type": "string",
          "description": "UTC time written, ISO 8601"
        }
      },
      "required": [
        "kind",
        "round",
        "at"
      ],
      "additionalProperties": false
    },
    "PrEvent": {
      "description": "A pull request was added to a round.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "pr"
        },
        "round": {
          "$ref": "#/$defs/RoundId"
        },
        "repo": {
          "$ref": "#/$defs/Repo"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "at": {
          "type": "string",
          "description": "UTC time written, ISO 8601"
        }
      },
      "required": [
        "kind",
        "round",
        "repo",
        "number",
        "at"
      ],
      "additionalProperties": false
    },
    "ClosedPr": {
      "description": "A round's pull request and its head commit when the round closed.",
      "type": "object",
      "properties": {
        "repo": {
          "$ref": "#/$defs/Repo"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "head": {
          "type": "string",
          "description": "The head commit SHA at close"
        }
      },
      "required": [
        "repo",
        "number",
        "head"
      ],
      "additionalProperties": false
    },
    "CloseEvent": {
      "description": "A round was closed, with the retro's inputs.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "close"
        },
        "round": {
          "$ref": "#/$defs/RoundId"
        },
        "at": {
          "type": "string",
          "description": "UTC time written, ISO 8601"
        },
        "sessions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The sessions that did the work"
        },
        "plan": {
          "type": "string",
          "description": "The plan or lane page"
        },
        "prs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClosedPr"
          }
        }
      },
      "required": [
        "kind",
        "round",
        "at",
        "sessions",
        "plan",
        "prs"
      ],
      "additionalProperties": false
    },
    "Disposition": {
      "description": "What became of one change a retro proposed.",
      "type": "string",
      "enum": [
        "accepted",
        "declined",
        "later"
      ]
    },
    "RetroChange": {
      "description": "One change a retro proposed, and its disposition.",
      "type": "object",
      "properties": {
        "change": {
          "type": "string"
        },
        "disposition": {
          "$ref": "#/$defs/Disposition"
        }
      },
      "required": [
        "change",
        "disposition"
      ],
      "additionalProperties": false
    },
    "RetroEvent": {
      "description": "A closed round's retro ran; any retro event clears the round's retro debt.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "retro"
        },
        "round": {
          "$ref": "#/$defs/RoundId"
        },
        "at": {
          "type": "string",
          "description": "UTC time written, ISO 8601"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The sources the retro actually read"
        },
        "findings": {
          "type": "integer",
          "minimum": 0,
          "description": "How many findings the retro made; zero is valid"
        },
        "findings_at": {
          "type": "string",
          "description": "Where the findings live"
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RetroChange"
          },
          "description": "One disposition per proposed change"
        }
      },
      "required": [
        "kind",
        "round",
        "at",
        "sources",
        "findings",
        "findings_at",
        "changes"
      ],
      "additionalProperties": false
    },
    "RoundEvent": {
      "description": "One line of a lane's store file.",
      "anyOf": [
        {
          "$ref": "#/$defs/OpenEvent"
        },
        {
          "$ref": "#/$defs/PrEvent"
        },
        {
          "$ref": "#/$defs/CloseEvent"
        },
        {
          "$ref": "#/$defs/RetroEvent"
        }
      ]
    },
    "PullHead": {
      "description": "The head of a pull request, the part read here.",
      "type": "object",
      "properties": {
        "sha": {
          "type": "string"
        }
      },
      "required": [
        "sha"
      ],
      "additionalProperties": true
    },
    "GitHubPull": {
      "description": "The pull request fields read from GitHub; other API fields pass.",
      "type": "object",
      "properties": {
        "number": {
          "type": "integer"
        },
        "head": {
          "$ref": "#/$defs/PullHead"
        }
      },
      "required": [
        "number",
        "head"
      ],
      "additionalProperties": true
    },
    "PrRef": {
      "description": "A pull request of a round.",
      "type": "object",
      "properties": {
        "repo": {
          "$ref": "#/$defs/Repo"
        },
        "number": {
          "type": "integer"
        }
      },
      "required": [
        "repo",
        "number"
      ],
      "additionalProperties": false
    },
    "OpenRound": {
      "description": "A report line: a round opened and not closed.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "open-round"
        },
        "round": {
          "$ref": "#/$defs/RoundId"
        },
        "opened_at": {
          "type": "string"
        },
        "prs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PrRef"
          }
        }
      },
      "required": [
        "kind",
        "round",
        "opened_at",
        "prs"
      ],
      "additionalProperties": false
    },
    "RetroOwed": {
      "description": "A report line: a closed round with no retro event, and the inputs its retro starts from.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "retro-owed"
        },
        "round": {
          "$ref": "#/$defs/RoundId"
        },
        "closed_at": {
          "type": "string"
        },
        "sessions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "plan": {
          "type": "string"
        },
        "prs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClosedPr"
          }
        }
      },
      "required": [
        "kind",
        "round",
        "closed_at",
        "sessions",
        "plan",
        "prs"
      ],
      "additionalProperties": false
    },
    "SectionName": {
      "description": "A report section.",
      "type": "string",
      "enum": [
        "open-rounds",
        "owing-retro"
      ]
    },
    "ReportSection": {
      "description": "A report section's last line: how many lines it printed, or unknown with the reason.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "section"
        },
        "section": {
          "$ref": "#/$defs/SectionName"
        },
        "count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Lines printed; null when unknown"
        },
        "unknown": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why the section's input could not be read; null when it was read"
        }
      },
      "required": [
        "kind",
        "section",
        "count",
        "unknown"
      ],
      "additionalProperties": false
    },
    "Frontmatter": {
      "description": "Check every SKILL.md and okf concept file's frontmatter, and that every YAML file parses, as the index has them.",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "SkillTable": {
      "description": "Check the workflow docs' skills.md against the user-scope mattpocock-skills plugin install.",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "Listing": {
      "description": "Which tickets to print after a clean check.",
      "type": "string",
      "enum": [
        "frontier",
        "open"
      ]
    },
    "Tickets": {
      "description": "Check the roadmap's ticket lines against GitHub; list, rebuild or resolve a plan.",
      "type": "object",
      "properties": {
        "roadmap": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Roadmap file; default <main checkout>/task_plan.md"
        },
        "spec": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "listing": {
          "anyOf": [
            {
              "$ref": "#/$defs/Listing"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "After a clean check, print the tickets ready to start (frontier) or not yet finished (open)"
        },
        "rebuild": {
          "type": "boolean",
          "default": false
        },
        "require_github": {
          "type": "boolean",
          "default": false,
          "description": "Exit 2 unless the scope was checked against GitHub"
        },
        "plan": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "SettingsLocal": {
      "description": "Refuse a .claude/settings.local.json in this worktree, in the main checkout, or in the index.",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "Options": {
      "description": "What a workflowtools command parses from its arguments.",
      "anyOf": [
        {
          "$ref": "#/$defs/Frontmatter"
        },
        {
          "$ref": "#/$defs/SkillTable"
        },
        {
          "$ref": "#/$defs/Tickets"
        },
        {
          "$ref": "#/$defs/SettingsLocal"
        },
        {
          "$ref": "#/$defs/RoundOpen"
        },
        {
          "$ref": "#/$defs/RoundPr"
        },
        {
          "$ref": "#/$defs/RoundClose"
        },
        {
          "$ref": "#/$defs/RoundRetro"
        },
        {
          "$ref": "#/$defs/Report"
        }
      ]
    },
    "Check": {
      "description": "The check a finding comes from.",
      "type": "string",
      "enum": [
        "frontmatter",
        "skill-table",
        "tickets",
        "settings-local",
        "rounds"
      ]
    },
    "Finding": {
      "description": "One problem, printed as a JSON line on stdout.",
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "File, relative to the repository root; settings-local names an absolute path in another checkout"
        },
        "check": {
          "$ref": "#/$defs/Check"
        },
        "detail": {
          "type": "string",
          "description": "What is wrong"
        }
      },
      "required": [
        "path",
        "check",
        "detail"
      ],
      "additionalProperties": false
    },
    "Skipped": {
      "description": "A check with nothing to compare, printed as a JSON line on stdout.",
      "type": "object",
      "properties": {
        "check": {
          "$ref": "#/$defs/Check"
        },
        "reason": {
          "type": "string",
          "description": "Why it compared nothing"
        }
      },
      "required": [
        "check",
        "reason"
      ],
      "additionalProperties": false
    },
    "Failure": {
      "description": "Why a command stopped, printed as a JSON line on stderr.",
      "type": "object",
      "properties": {
        "error": {
          "type": "string",
          "description": "The message"
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    },
    "SkillFrontmatter": {
      "description": "The SKILL.md frontmatter keys every harness needs; others pass.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The skill name",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "When the skill applies",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "description"
      ],
      "additionalProperties": true
    },
    "OkfFrontmatter": {
      "description": "An okf concept file's frontmatter: a type; others pass.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "The concept type",
          "minLength": 1
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": true
    },
    "PluginManifest": {
      "description": "The part of a Claude Code plugin's .claude-plugin/plugin.json read here.",
      "type": "object",
      "properties": {
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Skill folders, relative to the plugin root"
        }
      },
      "required": [
        "skills"
      ],
      "additionalProperties": true
    },
    "PluginRecord": {
      "description": "One install of a plugin in ~/.claude/plugins/installed_plugins.json.",
      "type": "object",
      "properties": {
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "user, project or local"
        },
        "projectPath": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The project a project-scoped install belongs to"
        },
        "installPath": {
          "type": "string",
          "description": "Where the plugin's files are"
        },
        "gitCommitSha": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The plugin commit installed"
        }
      },
      "required": [
        "installPath"
      ],
      "additionalProperties": true
    },
    "InstalledPlugins": {
      "description": "~/.claude/plugins/installed_plugins.json, the part read here.",
      "type": "object",
      "properties": {
        "plugins": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/PluginRecord"
            }
          },
          "description": "Installs by plugin id"
        }
      },
      "required": [
        "plugins"
      ],
      "additionalProperties": true
    },
    "IssueState": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ]
    },
    "GitHubIssue": {
      "description": "The issue fields read from GitHub; other API fields pass.",
      "type": "object",
      "properties": {
        "number": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/IssueState"
        },
        "html_url": {
          "type": "string"
        }
      },
      "required": [
        "number",
        "title",
        "state",
        "html_url"
      ],
      "additionalProperties": true
    },
    "IssueTicket": {
      "description": "One ticket line in a roadmap spec section.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "ticket"
        },
        "number": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "spec": {
          "type": "integer"
        },
        "line": {
          "type": "integer"
        },
        "checked": {
          "type": "boolean"
